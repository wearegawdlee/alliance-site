{
  "name": "gdor_backoffice",
  "version": "0.2.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "db:drop-schema": "dotenv -e .env -- node scripts/drop-schema.js",
    "db:migrate": "dotenv -e .env -- node-pg-migrate up",
    "db:seed:users": "dotenv -e .env -- node scripts/seed-users.js",
    "db:seed:domain": "dotenv -e .env -- node scripts/seed-domain.js",
    "db:reset": "npm run db:drop-schema && npm run db:migrate && npm run db:seed:users && npm run db:seed:domain && npm run db:seed:tax-rates",
    "bootstrap": "npm install && npm run db:reset",
    "notify:test": "dotenv -e .env -- node scripts/send-test-notification.js",
    "db:seed:tax-rates": "dotenv -e .env -- node scripts/seed-ga-tax-rates.js",
    "pretest": "node scripts/reset-test-db.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.13.1",
    "nodemailer": "^6.9.16",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "node-pg-migrate": "^7.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
