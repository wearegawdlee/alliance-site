{
  "name": "gdor_backoffice",
  "version": "0.2.0",
  "private": true,
  "description": "Back office starter app for garage door operations and lead tracking.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "seed": "node scripts/seed.js",
    "seed:users": "node db/seed-users.js",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "dotenv -e .env -- node-pg-migrate up",
    "migrate:down": "dotenv -e .env -- node-pg-migrate down"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "node-pg-migrate": "^8.0.4"
  }
}
