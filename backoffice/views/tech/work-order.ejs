<%- include('../partials-header', { title: workOrder.title }) %>

<section class="page-header tech-page-header"><div><h1><%= workOrder.title %></h1><p><span class="badge"><%= workOrder.status %></span> · <%= workOrder.service_line %></p></div><a class="button secondary" href="<%= routePath('/tech/dashboard') %>">Back</a></section>

<% if(workOrder.isLocked){ %><section class="card"><p class="muted"><strong>Locked:</strong> this work order is immutable because the associated invoice has been paid.</p></section><% } %>

<% if(query && query.payment === 'success'){ %>
<section class="card success-card"><p><strong>Payment started.</strong> Stripe will confirm the payment shortly. If the customer completed checkout, this invoice will update automatically.</p></section>
<% } %>
<% if(query && query.payment === 'cancelled'){ %>
<section class="card warning-card"><p><strong>Payment cancelled.</strong> No payment was collected.</p></section>
<% } %>
<% if(query && query.payment === 'missing_items'){ %>
<section class="card warning-card"><p><strong>Add service items first.</strong> The system needs at least one billable item before it can collect payment.</p></section>
<% } %>

<section class="card tech-job-summary">
  <h2><%= workOrder.customer %></h2>
  <p><strong>Address</strong><br><%= [workOrder.address_line_1, workOrder.city, workOrder.state, workOrder.postal_code].filter(Boolean).join(', ') || '—' %></p>
  <% if(workOrder.description){ %><p><strong>Description</strong><br><%= workOrder.description %></p><% } %>
  <p class="muted"><%= workOrder.scheduled_start_at ? new Date(workOrder.scheduled_start_at).toLocaleString() : 'Unscheduled' %></p>
</section>

<section class="card" id="items">
  <div class="section-title-row"><h2>Service Items</h2><strong><%= formatCurrency(workOrder.lineItemTotal) %></strong></div>
  <% workOrder.lineItems.forEach(item => { %><div class="tech-line-item"><div><strong><%= item.description %></strong><p class="muted"><%= item.sku ? item.sku + ' · ' : '' %><%= item.catalog_name || 'Custom' %></p></div><div><%= item.quantity %> × <%= formatCurrency(item.unit_price) %></div></div><% }) %>
  <% if(!workOrder.lineItems.length){ %><p class="muted">No service items yet.</p><% } %>
  <% if(!workOrder.isLocked){ %>
  <h3>Add Item</h3>
  <form method="post" action="<%= routePath('/tech/work-orders/' + workOrder.id + '/line-items') %>" class="form-grid tech-form">
    <label>Category<select id="catalogCategoryFilter"><option value="">All categories</option><% (workOrder.catalogCategories || []).forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label>
    <label>Catalog Item<select name="catalog_item_id" id="catalogItemSelect"><option value="">Custom / not in catalog</option><% workOrder.catalogItems.forEach(i=>{ %><option value="<%= i.id %>" data-category-id="<%= i.catalog_category_id || '' %>" data-price="<%= i.effective_unit_price || i.unit_price || '' %>" data-description="<%= i.name || '' %>"><%= i.category_name ? i.category_name + ' · ' : '' %><%= i.sku ? i.sku + ' · ' : '' %><%= i.name %> (<%= formatCurrency(i.effective_unit_price || i.unit_price) %><%= i.has_customer_price ? ' customer rate' : '' %>)</option><% }) %></select></label>
    <label>Description<input id="descriptionField" name="description" placeholder="What was done?"></label>
    <div class="grid two"><label>Qty<input type="number" step="0.01" name="quantity" value="1"></label><label>Price<input id="unitPriceField" type="number" step="0.01" name="unit_price" value=""></label></div>
    <button class="button primary full">Add Item</button>
  </form>
  <% } %>
</section>



<% const activeInvoice = (workOrder.invoices || []).find(i => i.status_code !== 'paid') || (workOrder.invoices || [])[0]; %>
<section class="card tech-payment-card" id="payment">
  <div class="section-title-row"><h2>Collect Payment</h2><strong><%= formatCurrency(workOrder.lineItemTotal) %></strong></div>
  <% if(activeInvoice){ %>
    <p class="muted">Invoice <strong><%= activeInvoice.invoice_number || ('#' + activeInvoice.id) %></strong> · <%= activeInvoice.status %></p>
  <% } else { %>
    <p class="muted">No invoice exists yet. Collecting payment will prepare the invoice from the current service items.</p>
  <% } %>
  <% if(workOrder.invoice_status_code === 'paid' || (activeInvoice && activeInvoice.status_code === 'paid')){ %>
    <p><strong>Paid.</strong> This job is locked because the invoice has been paid.</p>
  <% } else if(!workOrder.lineItems.length){ %>
    <p class="muted">Add at least one service item before collecting payment.</p>
  <% } else { %>
    <div class="tech-payment-actions">
      <form method="post" action="<%= routePath('/tech/work-orders/' + workOrder.id + '/collect-payment') %>">
        <button class="button primary full">Collect Card Payment Now</button>
      </form>
      <form method="post" action="<%= routePath('/tech/work-orders/' + workOrder.id + '/customer-payment-page') %>">
        <button class="button secondary full">Open Customer Pay Page</button>
      </form>
    </div>
    
    <% if(customerPaymentLink){ %>
      <label>Customer payment link<input readonly value="<%= customerPaymentLink %>" onclick="this.select()"></label>
    <% } %>
  <% } %>
</section>

<section class="card" id="notes"><h2>Notes</h2>
  <% if(!workOrder.isLocked){ %><form method="post" action="<%= routePath('/tech/work-orders/' + workOrder.id + '/notes') %>" class="note-form tech-form"><textarea name="note_body" placeholder="Field note, customer approval, parts needed, etc."></textarea><button class="button primary full">Add Note</button></form><% } %>
  <% workOrder.notes.forEach(n=>{ %><div class="note"><%= n.note_body %><small><%= n.author || 'System' %> · <%= formatDate(n.created_at) %></small></div><% }) %>
</section>

<% if(!workOrder.isLocked && workOrder.status_code !== 'cancelled'){ %>
<section class="tech-sticky-actions"><a class="button secondary" href="#items">+ Item</a><a class="button secondary" href="#notes">+ Note</a><a class="button secondary" href="#payment">Pay</a><form method="post" action="<%= routePath('/tech/work-orders/' + workOrder.id + '/complete') %>"><button class="button primary">Complete</button></form></section>
<% } %>

<script>
document.addEventListener('DOMContentLoaded', function(){
  const categoryFilter=document.getElementById('catalogCategoryFilter');
  const catalogSelect=document.getElementById('catalogItemSelect');
  const unitPriceField=document.getElementById('unitPriceField');
  const descriptionField=document.getElementById('descriptionField');
  if(catalogSelect && unitPriceField && descriptionField){
    function filterCatalogItems(){
      const categoryId=categoryFilter ? categoryFilter.value : '';
      Array.from(catalogSelect.options).forEach(option=>{ if(!option.value){ option.hidden=false; return; } option.hidden=!!categoryId && option.dataset.categoryId !== categoryId; });
      const selectedOption=catalogSelect.options[catalogSelect.selectedIndex];
      if(selectedOption && selectedOption.hidden){ catalogSelect.value=''; unitPriceField.value=''; }
    }
    if(categoryFilter){ categoryFilter.addEventListener('change', filterCatalogItems); filterCatalogItems(); }
    catalogSelect.addEventListener('change', function(){ const selectedOption=this.options[this.selectedIndex]; if(!selectedOption || !selectedOption.value){ unitPriceField.value=''; return; } const price=selectedOption.dataset.price; if(price !== undefined && price !== null && price !== '') unitPriceField.value=Number(price).toFixed(2); if(!descriptionField.value.trim()) descriptionField.value=selectedOption.dataset.description || selectedOption.text.replace(/\s+\(.*\)\s*$/,'').trim(); });
  }
});
</script>

<%- include('../partials-footer') %>
