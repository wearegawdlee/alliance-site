<% const isAuthLayout = typeof hideSidebar !== 'undefined' ? hideSidebar : false; %>
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title || appConfig.brand.backofficeName %> | <%= appConfig.brand.shortName %></title><link rel="stylesheet" href="<%= assetPath('/styles.css') %>"></head><body><div class="app-shell <%= isAuthLayout ? 'auth-shell' : '' %>">
<% if(!isAuthLayout){ %><aside class="sidebar"><div class="brand"><div class="brand-mark">A</div><div><strong><%= appConfig.brand.shortName %></strong><span><%= appConfig.brand.backofficeName %></span></div></div><nav class="nav"><a href="<%= routePath('/dashboard') %>">Dashboard</a><a href="<%= routePath('/work-orders') %>">Work Orders</a><a href="<%= routePath('/customers') %>">Customers</a><a href="<%= routePath('/billing') %>">Billing</a><a href="<%= routePath('/catalog') %>">Catalog</a><a href="<%= routePath('/tax-rates') %>">Tax Rates</a></nav><div class="sidebar-footer"><div class="user"><%= currentUser && currentUser.email %></div><form method="post" action="<%= routePath('/logout') %>"><button class="button secondary full">Log Out</button></form></div></aside><% } %><main class="main">
