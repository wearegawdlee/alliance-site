<%- include('../partials-header', { title }) %>
<section class="page-header"><div><h1><%= item ? 'Edit Catalog Item' : 'New Catalog Item' %></h1><p>Keep this generic enough to support garage doors, pools, motorized screens, and future services.</p></div><a class="button secondary" href="<%= routePath('/catalog') %>">Back</a></section>
<section class="card"><form method="post" action="<%= item ? routePath('/catalog/' + item.id) : routePath('/catalog') %>" class="form-grid"><div class="grid two"><label>Name<input name="name" value="<%= item?.name || '' %>" required></label><label>SKU<input name="sku" value="<%= item?.sku || '' %>"></label></div><label>Description<textarea name="description"><%= item?.description || '' %></textarea></label><div class="grid two"><label>Service Line<select name="service_line_id" id="serviceLineSelect"><option value="">General / any service</option><% options.serviceLines.forEach(s=>{ %><option value="<%= s.id %>" <%= Number(item?.service_line_id||0)===Number(s.id) ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label><label>Category<select name="catalog_category_id" id="catalogCategorySelect"><option value="">Uncategorized</option><% options.categories.forEach(c=>{ %><option value="<%= c.id %>" data-service-line-id="<%= c.service_line_id %>" <%= Number(item?.catalog_category_id||0)===Number(c.id) ? 'selected' : '' %>><%= c.service_line %> · <%= c.name %></option><% }) %></select></label></div><div class="grid two"><label>Type<select name="item_type"><% options.itemTypes.forEach(t=>{ %><option value="<%= t %>" <%= (item?.item_type || 'service')===t ? 'selected' : '' %>><%= t %></option><% }) %></select></label><label>Unit Price<input type="number" step="0.01" name="unit_price" value="<%= item?.unit_price ?? 0 %>"></label></div><div class="grid two"><label>Cost<input type="number" step="0.01" name="cost" value="<%= item?.cost ?? '' %>"></label><label class="check"><input type="checkbox" name="is_active" value="1" <%= !item || item.is_active ? 'checked' : '' %>> Active</label></div><button class="button primary"><%= item ? 'Save Item' : 'Create Item' %></button></form></section>
<script>
document.addEventListener('DOMContentLoaded', function(){
  const serviceSelect=document.getElementById('serviceLineSelect');
  const categorySelect=document.getElementById('catalogCategorySelect');
  if(!serviceSelect || !categorySelect) return;
  const options=Array.from(categorySelect.options);
  function filterCategories(){
    const serviceId=serviceSelect.value;
    options.forEach(option=>{
      if(!option.value){ option.hidden=false; return; }
      option.hidden=!!serviceId && option.dataset.serviceLineId!==serviceId;
    });
    const selected=categorySelect.options[categorySelect.selectedIndex];
    if(selected && selected.hidden) categorySelect.value='';
  }
  serviceSelect.addEventListener('change', filterCategories);
  filterCategories();
});
</script>
<%- include('../partials-footer') %>
