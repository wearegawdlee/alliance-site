<%- include('../partials-header', { title }) %>
<section class="page-header"><div><h1><%= item ? 'Edit Catalog Item' : 'New Catalog Item' %></h1><p>Keep this generic enough to support garage doors, pools, motorized screens, and future services.</p></div><a class="button secondary" href="<%= routePath('/catalog') %>">Back</a></section>
<section class="card"><form method="post" action="<%= item ? routePath('/catalog/' + item.id) : routePath('/catalog') %>" class="form-grid"><div class="grid two"><label>Name<input name="name" value="<%= item?.name || '' %>" required></label><label>SKU<input name="sku" value="<%= item?.sku || '' %>"></label></div><label>Description<textarea name="description"><%= item?.description || '' %></textarea></label><div class="grid two"><label>Service Line<select name="service_line_id"><option value="">General / any service</option><% options.serviceLines.forEach(s=>{ %><option value="<%= s.id %>" <%= Number(item?.service_line_id||0)===Number(s.id) ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label><label>Type<select name="item_type"><% options.itemTypes.forEach(t=>{ %><option value="<%= t %>" <%= (item?.item_type || 'service')===t ? 'selected' : '' %>><%= t %></option><% }) %></select></label></div><div class="grid two"><label>Unit Price<input type="number" step="0.01" name="unit_price" value="<%= item?.unit_price ?? 0 %>"></label><label>Cost<input type="number" step="0.01" name="cost" value="<%= item?.cost ?? '' %>"></label></div><label class="check"><input type="checkbox" name="is_active" value="1" <%= !item || item.is_active ? 'checked' : '' %>> Active</label><button class="button primary"><%= item ? 'Save Item' : 'Create Item' %></button></form></section>
<%- include('../partials-footer') %>
