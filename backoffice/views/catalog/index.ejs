<%- include('../partials-header', { title: 'Catalog' }) %>
<section class="page-header"><div><h1>Catalog</h1><p>Billable services, labor, parts, and material items.</p></div></section><section class="card"><table class="data-table"><thead><tr><th>SKU</th><th>Name</th><th>Type</th><th>Service</th><th>Unit Price</th><th>Cost</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><%= i.sku || '—' %></td><td><%= i.name %></td><td><%= i.item_type %></td><td><%= i.service_line || '—' %></td><td><%= formatCurrency(i.unit_price) %></td><td><%= formatCurrency(i.cost) %></td></tr><% }) %><% if(!items.length){ %><tr><td colspan="6">No catalog items.</td></tr><% } %></tbody></table></section>
<%- include('../partials-footer') %>
