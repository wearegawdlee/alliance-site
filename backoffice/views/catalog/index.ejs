<%- include('../partials-header', { title: 'Catalog' }) %>
<section class="page-header"><div><h1>Catalog</h1><p>Billable services, labor, parts, and material items used for service itemization and invoices.</p></div><div class="button-row"><a class="button primary" href="<%= routePath('/catalog/new') %>">New Item</a><a class="button secondary" href="<%= routePath('/catalog/categories/new') %>">New Category</a></div></section>
<section class="card"><form class="filter-form" method="get" action="<%= routePath('/catalog') %>"><label>Search<input name="search" value="<%= query.search || '' %>" placeholder="SKU, name, category..."></label><label>Service<select name="service_line_id"><option value="">All services</option><% options.serviceLines.forEach(s=>{ %><option value="<%= s.id %>" <%= String(query.service_line_id||'')===String(s.id) ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label><label>Category<select name="catalog_category_id"><option value="">All categories</option><% options.categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(query.catalog_category_id||'')===String(c.id) ? 'selected' : '' %>><%= c.service_line %> · <%= c.name %></option><% }) %></select></label><label>Type<select name="item_type"><option value="">All types</option><% options.itemTypes.forEach(t=>{ %><option value="<%= t %>" <%= query.item_type===t ? 'selected' : '' %>><%= t %></option><% }) %></select></label><label>Status<select name="active"><option value="">All</option><option value="active" <%= query.active==='active' ? 'selected' : '' %>>Active</option><option value="inactive" <%= query.active==='inactive' ? 'selected' : '' %>>Inactive</option></select></label><div class="filter-actions"><button class="button primary">Filter</button><a class="button secondary" href="<%= routePath('/catalog') %>">Reset</a></div></form></section>
<section class="card"><div class="section-title-row"><h2>Categories</h2><span class="muted">Used to filter catalog item pickers in backoffice and future technician views.</span></div><table class="data-table"><thead><tr><th>Service</th><th>Category</th><th>Code</th><th>Items</th><th>Status</th><th></th></tr></thead><tbody><% categories.forEach(c=>{ %><tr><td><%= c.service_line %></td><td><a href="<%= routePath('/catalog/categories/' + c.id + '/edit') %>"><%= c.name %></a><br><span class="muted"><%= c.description || '' %></span></td><td><%= c.code %></td><td><%= c.item_count %></td><td><span class="badge"><%= c.is_active ? 'Active' : 'Inactive' %></span></td><td><form method="post" action="<%= routePath('/catalog/categories/' + c.id + '/delete') %>"><button class="button secondary">Delete</button></form></td></tr><% }) %><% if(!categories.length){ %><tr><td colspan="6">No categories match your filters.</td></tr><% } %></tbody></table></section>
<section class="card"><div class="section-title-row"><h2>Items</h2></div><table class="data-table"><thead><tr><th>SKU</th><th>Name</th><th>Category</th><th>Type</th><th>Service</th><th>Unit Price</th><th>Cost</th><th>Status</th><th></th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><%= i.sku || '—' %></td><td><a href="<%= routePath('/catalog/' + i.id + '/edit') %>"><%= i.name %></a><br><span class="muted"><%= i.description || '' %></span></td><td><%= i.category_name || 'Uncategorized' %></td><td><%= i.item_type %></td><td><%= i.service_line || '—' %></td><td><%= formatCurrency(i.unit_price) %></td><td><%= formatCurrency(i.cost) %></td><td><span class="badge"><%= i.is_active ? 'Active' : 'Inactive' %></span></td><td><form method="post" action="<%= routePath('/catalog/' + i.id + '/delete') %>"><button class="button secondary">Delete</button></form></td></tr><% }) %><% if(!items.length){ %><tr><td colspan="9">No catalog items match your filters.</td></tr><% } %></tbody></table></section>
<%- include('../partials-footer') %>
