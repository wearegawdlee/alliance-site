<%- include('../partials-header', { title: 'Catalog' }) %>
<section class="page-header"><div><h1>Catalog</h1><p>Billable services, labor, parts, and material items used for inspection itemization and invoices.</p></div><a class="button primary" href="<%= routePath('/catalog/new') %>">New Item</a></section>
<section class="card"><form class="filter-form" method="get" action="<%= routePath('/catalog') %>"><label>Search<input name="search" value="<%= query.search || '' %>" placeholder="SKU, name, description..."></label><label>Service<select name="service_line_id"><option value="">All services</option><% options.serviceLines.forEach(s=>{ %><option value="<%= s.id %>" <%= String(query.service_line_id||'')===String(s.id) ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label><label>Type<select name="item_type"><option value="">All types</option><% options.itemTypes.forEach(t=>{ %><option value="<%= t %>" <%= query.item_type===t ? 'selected' : '' %>><%= t %></option><% }) %></select></label><label>Status<select name="active"><option value="">All</option><option value="active" <%= query.active==='active' ? 'selected' : '' %>>Active</option><option value="inactive" <%= query.active==='inactive' ? 'selected' : '' %>>Inactive</option></select></label><div class="filter-actions"><button class="button primary">Filter</button><a class="button secondary" href="<%= routePath('/catalog') %>">Reset</a></div></form></section>
<section class="card"><table class="data-table"><thead><tr><th>SKU</th><th>Name</th><th>Type</th><th>Service</th><th>Unit Price</th><th>Cost</th><th>Status</th><th></th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><%= i.sku || '—' %></td><td><a href="<%= routePath('/catalog/' + i.id + '/edit') %>"><%= i.name %></a><br><span class="muted"><%= i.description || '' %></span></td><td><%= i.item_type %></td><td><%= i.service_line || '—' %></td><td><%= formatCurrency(i.unit_price) %></td><td><%= formatCurrency(i.cost) %></td><td><span class="badge"><%= i.is_active ? 'Active' : 'Inactive' %></span></td><td><form method="post" action="<%= routePath('/catalog/' + i.id + '/delete') %>"><button class="button secondary">Delete</button></form></td></tr><% }) %><% if(!items.length){ %><tr><td colspan="8">No catalog items match your filters.</td></tr><% } %></tbody></table></section>
<%- include('../partials-footer') %>
