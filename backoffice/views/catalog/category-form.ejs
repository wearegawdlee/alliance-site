<%- include('../partials-header', { title }) %>
<section class="page-header"><div><h1><%= category ? 'Edit Catalog Category' : 'New Catalog Category' %></h1><p>Categories group billable items so office and field users do not search one giant catalog.</p></div><a class="button secondary" href="<%= routePath('/catalog') %>">Back</a></section>
<section class="card"><form method="post" action="<%= category ? routePath('/catalog/categories/' + category.id) : routePath('/catalog/categories') %>" class="form-grid"><div class="grid two"><label>Name<input name="name" value="<%= category?.name || '' %>" required></label><label>Code<input name="code" value="<%= category?.code || '' %>" placeholder="auto-generated from name if blank"></label></div><label>Service Line<select name="service_line_id" required><option value="">Select service line</option><% options.serviceLines.forEach(s=>{ %><option value="<%= s.id %>" <%= Number(category?.service_line_id||0)===Number(s.id) ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label><label>Description<textarea name="description"><%= category?.description || '' %></textarea></label><div class="grid two"><label>Sort Order<input type="number" step="1" name="sort_order" value="<%= category?.sort_order ?? 0 %>"></label><label class="check"><input type="checkbox" name="is_active" value="1" <%= !category || category.is_active ? 'checked' : '' %>> Active</label></div><button class="button primary"><%= category ? 'Save Category' : 'Create Category' %></button></form></section>
<%- include('../partials-footer') %>
