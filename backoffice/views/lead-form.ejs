<%- include('partials-header', { title: `${pageTitle} | gdor_backoffice` }) %>

<section class="page-header">
  <div>
    <h1><%= pageTitle %></h1>
    <p>Create or update a lead record.</p>
  </div>
  <a class="button button-secondary" href="<%= routePath('/leads') %>">Back to Leads</a>
</section>

<section class="card form-card">
  <form method="POST" action="<%= formAction %>" class="lead-form">
    <div class="form-grid two-column">
      <label>
        <span>Customer Name</span>
        <input type="text" name="customer_name" value="<%= lead.customer_name || '' %>" required />
      </label>

      <label>
        <span>Phone</span>
        <input type="text" name="phone" value="<%= lead.phone || '' %>" required />
      </label>

      <label>
        <span>Email</span>
        <input type="email" name="email" value="<%= lead.email || '' %>" />
      </label>

      <label>
        <span>Address</span>
        <input type="text" name="address_line_1" value="<%= lead.address_line_1 || '' %>" />
      </label>

      <label>
        <span>City</span>
        <input type="text" name="city" value="<%= lead.city || '' %>" />
      </label>

      <label>
        <span>State</span>
        <input type="text" name="state" value="<%= lead.state || '' %>" />
      </label>

      <label>
        <span>Zip Code</span>
        <input type="text" name="zip_code" value="<%= lead.zip_code || '' %>" />
      </label>

      <label>
        <span>Service Type</span>
        <select name="service_type">
          <% serviceTypeOptions.forEach((option) => { %>
            <option value="<%= option %>" <%= lead.service_type === option ? 'selected' : '' %>><%= formatLabel(option) %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>Lead Source</span>
        <select name="lead_source">
          <% leadSourceOptions.forEach((option) => { %>
            <option value="<%= option %>" <%= lead.lead_source === option ? 'selected' : '' %>><%= formatLabel(option) %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>Status</span>
        <select name="status">
          <% statusOptions.forEach((option) => { %>
            <option value="<%= option %>" <%= (lead.status || 'new') === option ? 'selected' : '' %>><%= formatLabel(option) %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>Assigned To</span>
        <select name="assigned_user_id">
          <option value="">Unassigned</option>
          <% users.forEach((user) => { %>
            <option value="<%= user.id %>" <%= Number(lead.assigned_user_id) === user.id ? 'selected' : '' %>><%= user.name %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>Quoted Price</span>
        <input type="number" step="0.01" min="0" name="quoted_price" value="<%= lead.quoted_price ?? '' %>" />
      </label>

      <label>
        <span>Follow Up Date</span>
        <input type="date" name="follow_up_date" value="<%= lead.follow_up_date || '' %>" />
      </label>
    </div>

    <div class="form-grid">
      <label>
        <span>Next Action</span>
        <input type="text" name="next_action" value="<%= lead.next_action || '' %>" />
      </label>

      <label>
        <span>Description / Notes</span>
        <textarea name="description" rows="6"><%= lead.description || '' %></textarea>
      </label>
    </div>

    <div class="form-actions">
      <button class="button button-primary" type="submit">Save Lead</button>
      <a class="button button-secondary" href="<%= routePath('/leads') %>">Cancel</a>
    </div>
  </form>
</section>

<%- include('partials-footer') %>
