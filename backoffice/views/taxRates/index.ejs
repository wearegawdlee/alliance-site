<%- include('../partials-header', { title: 'Tax Rates' }) %>

<section class="page-header">
  <div>
    <h1>Tax Rates</h1>
    <p>Simple county/city/postal sales tax rates used when calculating invoice totals. Rates are stored on invoices when applied so historical invoices remain stable.</p>
  </div>
  <a class="button primary" href="<%= routePath('/tax-rates/new') %>">New Tax Rate</a>
</section>

<section class="card">
  <form class="filter-form" method="get" action="<%= routePath('/tax-rates') %>">
    <label>
      Search
      <input name="search" value="<%= query.search || '' %>" placeholder="County, city, ZIP...">
    </label>

    <label>
      Status
      <select name="active">
        <option value="">All</option>
        <option value="active" <%= query.active === 'active' ? 'selected' : '' %>>Active</option>
        <option value="inactive" <%= query.active === 'inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </label>

    <div class="filter-actions">
      <button class="button primary">Filter</button>
      <a class="button secondary" href="<%= routePath('/tax-rates') %>">Reset</a>
    </div>
  </form>
</section>

<section class="card">
  <table class="data-table">
    <thead>
      <tr>
        <th>State</th>
        <th>County</th>
        <th>City</th>
        <th>ZIP</th>
        <th>Rate</th>
        <th>Effective</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% taxRates.forEach(rate => { %>
        <tr>
          <td><%= rate.state %></td>
          <td><a href="<%= routePath('/tax-rates/' + rate.id + '/edit') %>"><%= rate.county %></a></td>
          <td><%= rate.city || '—' %></td>
          <td><%= rate.postal_code || '—' %></td>
          <td><%= rate.rate_percent %>%</td>
          <td>
            <%= formatDate(rate.effective_start_date) %>
            <% if(rate.effective_end_date){ %>
              – <%= formatDate(rate.effective_end_date) %>
            <% } %>
          </td>
          <td><span class="badge"><%= rate.is_active ? 'Active' : 'Inactive' %></span></td>
          <td>
            <form method="post" action="<%= routePath('/tax-rates/' + rate.id + '/delete') %>">
              <button class="button secondary">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>

      <% if(!taxRates.length){ %>
        <tr><td colspan="8">No tax rates match your filters.</td></tr>
      <% } %>
    </tbody>
  </table>
</section>

<%- include('../partials-footer') %>
