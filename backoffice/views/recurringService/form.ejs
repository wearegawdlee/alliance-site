<%- include('../partials-header', { title }) %>
<section class="page-header"><div><h1><%= plan ? 'Edit Recurring Plan' : 'New Recurring Plan' %></h1><p>Creates normal work orders on a schedule without changing the atomic work order flow.</p></div><a class="button secondary" href="<%= plan ? routePath('/recurring-service/' + plan.id) : routePath('/recurring-service') %>">Back</a></section>
<section class="card">
<form method="post" action="<%= plan ? routePath('/recurring-service/' + plan.id) : routePath('/recurring-service') %>" class="form-grid">
  <div class="grid two"><label>Customer<select name="customer_id" id="customerSelect" required><option value="">Select customer</option><% options.customers.forEach(c=>{ %><option value="<%= c.id %>" <%= plan && Number(plan.customer_id)===Number(c.id)?'selected':'' %>><%= c.display_name %></option><% }) %></select></label><label>Location<select name="customer_location_id" id="locationSelect" required><option value="">Select location</option><% (locations||[]).forEach(l=>{ %><option value="<%= l.id %>" <%= plan && Number(plan.customer_location_id)===Number(l.id)?'selected':'' %>><%= [l.label,l.address_line_1,l.city,l.state].filter(Boolean).join(' · ') %></option><% }) %></select></label></div>
  <div class="grid two"><label>Service Line<select name="service_line_id" required><option value="">Select service</option><% options.serviceLines.forEach(sl=>{ %><option value="<%= sl.id %>" <%= plan && Number(plan.service_line_id)===Number(sl.id)?'selected':'' %>><%= sl.name %></option><% }) %></select></label><label>Assigned Technician<select name="assigned_user_id"><option value="">Unassigned</option><% options.users.forEach(u=>{ %><option value="<%= u.id %>" <%= plan && Number(plan.assigned_user_id)===Number(u.id)?'selected':'' %>><%= u.display_name %></option><% }) %></select></label></div>
  <label>Title<input name="title" value="<%= plan?.title || '' %>" placeholder="Weekly pool maintenance" required></label>
  <label>Description<textarea name="description" placeholder="Default work order description"><%= plan?.description || '' %></textarea></label>
  <div class="grid three"><label>Frequency<select name="frequency"><option value="weekly" <%= !plan || plan.frequency==='weekly'?'selected':'' %>>Weekly</option><option value="biweekly" <%= plan?.frequency==='biweekly'?'selected':'' %>>Biweekly</option><option value="monthly" <%= plan?.frequency==='monthly'?'selected':'' %>>Monthly</option></select></label><label>Every<input type="number" min="1" name="interval_count" value="<%= plan?.interval_count || 1 %>"></label><label>Next Run Date<input type="text" class="js-date-picker" name="next_run_date" value="<%= plan?.next_run_date ? new Date(plan.next_run_date).toISOString().slice(0,10) : '' %>" placeholder="YYYY-MM-DD" required></label></div>
  <label class="check"><input type="checkbox" name="is_active" <%= !plan || plan.is_active ? 'checked' : '' %>> Active</label>
  <button class="button primary"><%= plan ? 'Save Plan' : 'Create Plan' %></button>
</form>
</section>
<script>
document.addEventListener('DOMContentLoaded',()=>{const c=document.getElementById('customerSelect');const l=document.getElementById('locationSelect');if(!c||!l)return;c.addEventListener('change',async()=>{l.innerHTML='<option value="">Loading...</option>';if(!c.value){l.innerHTML='<option value="">Select location</option>';return;}const res=await fetch('<%= routePath('/recurring-service/customers') %>/'+c.value+'/locations');const data=await res.json();l.innerHTML='<option value="">Select location</option>'+data.map(x=>`<option value="${x.id}">${[x.label,x.address_line_1,x.city,x.state].filter(Boolean).join(' · ')}</option>`).join('');});});
</script>
<%- include('../partials-footer') %>
