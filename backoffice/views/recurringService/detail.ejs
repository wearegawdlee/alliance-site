<%- include('../partials-header', { title: plan.title }) %>
<section class="page-header"><div><h1><%= plan.title %></h1><p><span class="badge"><%= plan.is_active ? 'Active' : 'Inactive' %></span> · <%= plan.service_line %> · <%= plan.customer %></p></div><div class="button-row"><a class="button secondary" href="<%= routePath('/recurring-service') %>">Back</a><a class="button secondary" href="<%= routePath('/recurring-service/' + plan.id + '/edit') %>">Edit</a><form method="post" action="<%= routePath('/recurring-service/' + plan.id + '/generate') %>"><button class="button primary">Generate Next Work Order</button></form></div></section>
<section class="card"><h2>Plan</h2><div class="grid two"><p><strong>Customer</strong><br><%= plan.customer %></p><p><strong>Location</strong><br><%= [plan.address_line_1,plan.city,plan.state,plan.postal_code].filter(Boolean).join(', ') %></p><p><strong>Frequency</strong><br><%= plan.frequency %> every <%= plan.interval_count %></p><p><strong>Next Run</strong><br><%= new Date(plan.next_run_date).toLocaleDateString() %></p><p><strong>Assigned</strong><br><%= plan.assigned_to || 'Unassigned' %></p></div><p><strong>Description</strong><br><%= plan.description || '—' %></p></section>
<section class="card"><h2>Generated Work Orders</h2><table class="data-table"><thead><tr><th>Scheduled</th><th>Work Order</th><th>Status</th></tr></thead><tbody><% plan.runs.forEach(run=>{ %><tr><td><%= new Date(run.scheduled_for).toLocaleDateString() %></td><td><a href="<%= routePath('/work-orders/' + run.work_order_id) %>"><%= run.work_order_title %></a></td><td><%= run.work_order_status %></td></tr><% }) %><% if(!plan.runs.length){ %><tr><td colspan="3">No work orders generated yet.</td></tr><% } %></tbody></table></section>
<%- include('../partials-footer') %>
