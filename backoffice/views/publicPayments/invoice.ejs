<%- include('../partials-header', { title, hideSidebar: true }) %>
<% const invoice = detail.invoice; const paid = Number(detail.paidAmount || 0); const storedBalance = Number(invoice.balance_due || 0); const computedBalance = Math.max(0, Number(invoice.total_amount || 0) - Number(invoice.deposit_amount || 0)); const payableBase = invoice.status_code === 'paid' ? 0 : Math.max(storedBalance, computedBalance); const amountDue = Math.max(0, payableBase - paid); const serviceAddress = [invoice.address_line_1, invoice.address_line_2, invoice.city, invoice.state, invoice.postal_code].filter(Boolean).join(', '); %>

<section class="public-pay-hero compact">
  <div class="brand public-brand"><div class="brand-mark">A</div><div><strong><%= appConfig.brand.name %></strong><span>Secure payment portal</span></div></div>
</section>

<% if(query.payment === 'cancelled'){ %><div class="notice warning">Payment was cancelled. No charge was made.</div><% } %>

<section class="card public-invoice-card">
  <div class="section-title-row">
    <div>
      <h1><%= invoice.invoice_number || ('Invoice #' + invoice.id) %></h1>
      <p class="muted"><%= invoice.customer_name %></p>
    </div>
    <% if(invoice.status_code === 'paid'){ %><span class="badge success">Paid</span><% } else if(invoice.status_code === 'payment_pending'){ %><span class="badge attention">Payment Pending</span><% } else if(invoice.status_code === 'payment_failed'){ %><span class="badge danger">Payment Failed</span><% } else { %><span class="badge"><%= invoice.status_name %></span><% } %>
  </div>

  <div class="grid three payment-totals">
    <div><span class="muted">Invoice Total</span><strong><%= formatCurrency(invoice.total_amount || 0) %></strong></div>
    <div><span class="muted">Paid</span><strong><%= formatCurrency(paid) %></strong></div>
    <div><span class="muted">Amount Due</span><strong><%= formatCurrency(amountDue) %></strong></div>
  </div>

  <% if(serviceAddress){ %><p><strong>Service Address:</strong> <%= serviceAddress %></p><% } %>
  <% if(invoice.work_order_title){ %><p><strong>Service:</strong> <%= invoice.work_order_title %></p><% } %>
  <% if(invoice.due_date){ %><p><strong>Due Date:</strong> <%= new Date(invoice.due_date).toLocaleDateString() %></p><% } %>
</section>

<section class="card">
  <div class="section-title-row"><h2>Invoice Items</h2><strong><%= formatCurrency(invoice.subtotal || 0) %></strong></div>
  <table class="data-table"><thead><tr><th>Description</th><th>Qty</th><th>Amount</th></tr></thead><tbody>
    <% detail.lineItems.forEach(item => { %><tr><td><%= item.description %></td><td><%= item.quantity %></td><td><%= formatCurrency(item.line_total || 0) %></td></tr><% }) %>
    <% if(!detail.lineItems.length){ %><tr><td colspan="3">No line items available.</td></tr><% } %>
  </tbody></table>
</section>

<section class="card public-payment-actions">
  <h2>Payment Options</h2>
  <% if(invoice.status_code === 'paid'){ %>
    <p class="notice success">This invoice is already paid. Thank you.</p>
  <% } else if(amountDue <= 0){ %>
    <p class="notice warning">This invoice does not currently show a payable balance. Please contact Alliance Home Services if this looks wrong.</p>
  <% } else if(invoice.status_code === 'payment_pending'){ %>
    <p class="notice warning">A payment is currently processing. If you recently paid, no further action is needed.</p>
  <% } else { %>
    <form method="POST" action="/pay/i/<%= token %>/card-checkout">
      <button class="button primary full" type="submit">Pay <%= formatCurrency(amountDue) %> by Card</button>
    </form>
    <p class="muted">One-time online invoice payments are card-only.</p>
  <% } %>
  <hr>
  <h3>Recurring service?</h3>
  <p class="muted">Set up automatic payments for future recurring services by card or ACH bank transfer.</p>
  <a class="button secondary" href="/pay/autopay/<%= token %>">Set Up Autopay</a>
</section>

<%- include('../partials-footer') %>
