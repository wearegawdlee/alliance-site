<%- include('../partials-header', { title: workOrder.title }) %>

<section class="page-header">
  <div>
    <h1><%= workOrder.title %></h1>
    <p><span class="badge"><%= workOrder.status %></span> · <a href="<%= routePath('/customers/' + workOrder.customer_id) %>"><%= workOrder.customer %></a> · <%= workOrder.service_line %></p>
  </div>
  <a class="button secondary" href="<%= routePath('/work-orders') %>">Back</a>
</section>

<% if(workOrder.isLocked){ %>
<section class="card"><p class="muted"><strong>Locked:</strong> this work order is immutable because the associated invoice has been paid.</p></section>
<% } %>

<section class="card workflow-card">
  <h2>Work Order Status</h2>
  <div class="workflow-steps">
    <% const flow=[['open','1. Open'],['completed','2. Completed'],['cancelled','Cancelled']]; %>
    <% flow.forEach(f=>{ %><div class="step <%= workOrder.status_code === f[0] ? 'active' : '' %>"><%= f[1] %></div><% }) %>
  </div>
  <% if(!workOrder.isLocked && workOrder.status_code === 'open'){ %>
  <div class="button-row">
    <form method="post" action="<%= routePath('/work-orders/' + workOrder.id + '/transition') %>"><input type="hidden" name="action" value="complete"><button class="button primary">Complete Work Order</button></form>
    <form method="post" action="<%= routePath('/work-orders/' + workOrder.id + '/transition') %>"><input type="hidden" name="action" value="cancel"><button class="button secondary">Cancel Work Order</button></form>
  </div>
  <% } else if(workOrder.status_code === 'completed'){ %>
    <p class="muted">Completed. If the invoice is not paid yet, this work order can still be edited and completed again to regenerate the same invoice.</p>
    <% if(!workOrder.isLocked){ %>
      <form method="post" action="<%= routePath('/work-orders/' + workOrder.id + '/transition') %>"><input type="hidden" name="action" value="complete"><button class="button secondary">Regenerate Invoice From Work Order</button></form>
    <% } %>
  <% } %>
</section>

<div class="grid two">
  <section class="card">
    <h2>Job</h2>
    <p><strong>Location</strong><br><%= [workOrder.address_line_1, workOrder.city, workOrder.state, workOrder.postal_code].filter(Boolean).join(', ') || '—' %></p>
    <p><strong>Type</strong><br><%= workOrder.work_order_type || '—' %></p>
    <p><strong>Asset</strong><br><%= workOrder.asset || '—' %></p>
    <p><strong>Description</strong><br><%= workOrder.description || '—' %></p>
  </section>
  <section class="card">
    <h2>Scheduling</h2>
    <form method="post" action="<%= routePath('/work-orders/' + workOrder.id) %>" class="form-grid">
      <label>Technician<select name="assigned_user_id" <%= workOrder.isLocked ? 'disabled' : '' %>><option value="">Unassigned</option><% workOrder.users.forEach(u=>{ const assigned = workOrder.assignments.some(a => Number(a.user_id)===Number(u.id)); %><option value="<%= u.id %>" <%= assigned ? 'selected' : '' %>><%= u.display_name %></option><% }) %></select></label>
      <div class="grid two">
        <label>Scheduled Start<input type="text" class="js-datetime-picker" name="scheduled_start_at" value="<%= workOrder.scheduled_start_at ? new Date(workOrder.scheduled_start_at).toISOString().slice(0,16).replace('T',' ') : '' %>" placeholder="YYYY-MM-DD HH:MM" <%= workOrder.isLocked ? 'disabled' : '' %>></label>
        <label>Scheduled End<input type="text" class="js-datetime-picker" name="scheduled_end_at" value="<%= workOrder.scheduled_end_at ? new Date(workOrder.scheduled_end_at).toISOString().slice(0,16).replace('T',' ') : '' %>" placeholder="YYYY-MM-DD HH:MM" <%= workOrder.isLocked ? 'disabled' : '' %>></label>
      </div>
      <div class="grid two"><label>Quoted Price<input type="number" step="0.01" name="quoted_price" value="<%= workOrder.quoted_price || '' %>" <%= workOrder.isLocked ? 'disabled' : '' %>></label><label>Final Price<input type="number" step="0.01" name="final_price" value="<%= workOrder.final_price || '' %>" <%= workOrder.isLocked ? 'disabled' : '' %>></label></div>

      <div class="card subtle-card">
        <h4>Discount</h4>
        <p class="muted">Discount applied to the invoice when the work order is completed or regenerated.</p>

        <div class="grid two">
          <label>
            Type
            <select name="discount_type" id="discountTypeSelect" <%= workOrder.isLocked ? 'disabled' : '' %>>
              <% const discountTypes=[['none','None'],['military','Military'],['senior','Senior'],['courtesy','Courtesy'],['other','Other']]; %>
              <% discountTypes.forEach(d=>{ %>
                <option value="<%= d[0] %>" <%= (workOrder.discount_type || 'none') === d[0] ? 'selected' : '' %>><%= d[1] %></option>
              <% }) %>
            </select>
          </label>

          <label>
            Mode
            <select name="discount_value_type" id="discountValueTypeSelect" <%= workOrder.isLocked ? 'disabled' : '' %>>
              <option value="flat" <%= (workOrder.discount_value_type || 'flat') === 'flat' ? 'selected' : '' %>>Flat Amount</option>
              <option value="percent" <%= workOrder.discount_value_type === 'percent' ? 'selected' : '' %>>Percent</option>
            </select>
          </label>
        </div>

        <div class="grid two">
          <label id="discountAmountLabel">
            Amount
            <input type="number" step="0.01" name="discount_amount" value="<%= workOrder.discount_amount || '' %>" <%= workOrder.isLocked ? 'disabled' : '' %>>
          </label>
          <label id="discountPercentLabel">
            Percent
            <input type="number" step="0.01" name="discount_percent" value="<%= workOrder.discount_percent || '' %>" <%= workOrder.isLocked ? 'disabled' : '' %>>
          </label>
        </div>

        <label id="discountReasonLabel">
         Reason
          <input name="discount_reason" value="<%= workOrder.discount_reason || '' %>" placeholder="Required for Other; optional for standard discounts" <%= workOrder.isLocked ? 'disabled' : '' %>>
        </label>
      </div>


      <div class="card subtle-card">
        <h4>Deposit</h4>
        <p class="muted">Deposit applied to the invoice when the work order is completed or regenerated.</p>
        <div class="grid two">
          <label>
            Deposit Amount
            <input type="number" step="0.01" name="deposit_amount" value="<%= workOrder.deposit_amount || '' %>" <%= workOrder.isLocked ? 'disabled' : '' %>>
          </label>
          <label>
            Deposit Note
            <input name="deposit_note" value="<%= workOrder.deposit_note || '' %>" placeholder="Check #, cash, card, who received it, etc." <%= workOrder.isLocked ? 'disabled' : '' %>>
          </label>
        </div>
      </div>

      <label>Work Order Note<input name="reason" placeholder="Why this changed" <%= workOrder.isLocked ? 'disabled' : '' %>></label>
      <% if(!workOrder.isLocked){ %><button class="button primary">Save Work Order</button><% } %>
    </form>
  </section>
</div>

<section class="card">
  <div class="section-title-row"><div><h2>Service Items</h2></div><strong><%= formatCurrency(workOrder.lineItemTotal) %></strong></div>
  <table class="data-table"><thead><tr><th>Catalog</th><th>Description</th><th>Qty</th><th>Unit</th><th>Total</th><th></th></tr></thead><tbody>
    <% workOrder.lineItems.forEach(item=>{ %><tr><td><%= item.sku ? item.sku + ' · ' : '' %><%= item.catalog_name || 'Custom' %><br><span class="muted"><%= item.item_type || '' %></span></td><td><%= item.description %></td><td><%= item.quantity %></td><td><%= formatCurrency(item.unit_price) %></td><td><%= formatCurrency(item.line_total) %></td><td><% if(!workOrder.isLocked){ %><form method="post" action="<%= routePath('/work-orders/' + workOrder.id + '/line-items/' + item.id + '/delete') %>"><button class="button secondary">Remove</button></form><% } %></td></tr><% }) %>
    <% if(!workOrder.lineItems.length){ %><tr><td colspan="6">No inspection items yet. Completing this work order will not generate an invoice until items are added.</td></tr><% } %>
  </tbody></table>
  <% if(!workOrder.isLocked){ %>
  <h3>Add Item</h3>
  <form method="post" action="<%= routePath('/work-orders/' + workOrder.id + '/line-items') %>" class="form-grid">
    <label>Category<select id="catalogCategoryFilter"><option value="">All categories</option><% (workOrder.catalogCategories || []).forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label>
    <label>Catalog Item<select name="catalog_item_id" id="catalogItemSelect"><option value="">Custom / not in catalog</option><% workOrder.catalogItems.forEach(i=>{ %><option value="<%= i.id %>" data-category-id="<%= i.catalog_category_id || '' %>" data-price="<%= i.unit_price || '' %>" data-description="<%= i.name || '' %>"><%= i.category_name ? i.category_name + ' · ' : '' %><%= i.sku ? i.sku + ' · ' : '' %><%= i.name %> (<%= formatCurrency(i.unit_price) %>)</option><% }) %></select></label>
    <label>Description<input id="descriptionField" name="description" placeholder="Spring replacement, operator install, labor, etc."></label>
    <div class="grid two"><label>Quantity<input type="number" step="0.01" name="quantity" value="1"></label><label>Price<input id="unitPriceField" type="number" step="0.01" name="unit_price" value=""></label></div>
    <button class="button primary">Add Item</button>
  </form>
  <% } %>
</section>

<section class="card">
  <h2>Notes</h2>
  <% if(!workOrder.isLocked){ %><form method="post" action="<%= routePath('/work-orders/' + workOrder.id + '/notes') %>" class="note-form"><textarea name="note_body" placeholder="Technician evaluation, parts needed, customer approval, etc."></textarea><button class="button primary">Add Note</button></form><% } %>
  <% workOrder.notes.forEach(n=>{ %><div class="note"><%= n.note_body %><small><%= n.author || 'System' %> · <%= formatDate(n.created_at) %></small></div><% }) %>
</section>

<section class="card">
  <h2>Invoice</h2>
  <% if(workOrder.invoices.length){ %>
  <table class="data-table"><thead><tr><th>#</th><th>Status</th><th>Total</th></tr></thead><tbody><% workOrder.invoices.forEach(i=>{ %><tr><td><a href="<%= routePath('/billing/invoices/' + i.id) %>"><%= i.invoice_number || ('#' + i.id) %></a></td><td><%= i.status %></td><td><%= formatCurrency(i.total_amount) %></td></tr><% }) %></tbody></table>
  <% } else { %>
    <p class="muted">No invoice yet. Completing this work order with line items will generate one.</p>
  <% } %>
</section>

<section class="card"><h2>Status History</h2><table class="data-table"><thead><tr><th>When</th><th>From</th><th>To</th><th>By</th><th>Reason</th></tr></thead><tbody><% workOrder.history.forEach(h=>{ %><tr><td><%= formatDate(h.created_at) %></td><td><%= h.from_status || '—' %></td><td><%= h.to_status %></td><td><%= h.changed_by || 'System' %></td><td><%= h.reason || '—' %></td></tr><% }) %></tbody></table></section>

<script>
document.addEventListener('DOMContentLoaded', function(){
  const categoryFilter = document.getElementById('catalogCategoryFilter');
  const catalogSelect = document.getElementById('catalogItemSelect');
  const unitPriceField = document.getElementById('unitPriceField');
  const descriptionField = document.getElementById('descriptionField');
  if(catalogSelect && unitPriceField && descriptionField){
    const catalogOptions = Array.from(catalogSelect.options);

    function filterCatalogItems(){
      if(!categoryFilter) return;
      const categoryId = categoryFilter.value;
      catalogOptions.forEach(option => {
        if(!option.value){ option.hidden = false; return; }
        option.hidden = !!categoryId && option.dataset.categoryId !== categoryId;
      });
      const selectedOption = catalogSelect.options[catalogSelect.selectedIndex];
      if(selectedOption && selectedOption.hidden){
        catalogSelect.value = '';
        unitPriceField.value = '';
      }
    }

    if(categoryFilter){
      categoryFilter.addEventListener('change', filterCatalogItems);
      filterCatalogItems();
    }

    catalogSelect.addEventListener('change', function(){
      const selectedOption = this.options[this.selectedIndex];
      if(!selectedOption || !selectedOption.value){ unitPriceField.value = ''; return; }
      const price = selectedOption.dataset.price;
      if(price !== undefined && price !== null && price !== '') unitPriceField.value = Number(price).toFixed(2);
      if(!descriptionField.value.trim()) descriptionField.value = selectedOption.dataset.description || selectedOption.text.replace(/\s+\(.*\)\s*$/, '').trim();
    });
  }

  const discountValueType = document.getElementById('discountValueTypeSelect');
  const discountAmountLabel = document.getElementById('discountAmountLabel');
  const discountPercentLabel = document.getElementById('discountPercentLabel');

  function updateDiscountMode(){
    if(!discountValueType || !discountAmountLabel || !discountPercentLabel) return;
    const isPercent = discountValueType.value === 'percent';
    discountAmountLabel.style.display = isPercent ? 'none' : '';
    discountPercentLabel.style.display = isPercent ? '' : 'none';
  }

  if(discountValueType){
    discountValueType.addEventListener('change', updateDiscountMode);
    updateDiscountMode();
  }
});
</script>

<%- include('../partials-footer') %>
