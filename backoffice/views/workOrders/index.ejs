<%- include('../partials-header', { title: 'Work Orders' }) %>
<section class="page-header"><div><h1>Work Orders</h1><p>Field work by customer location, service line, and asset.</p></div></section><section class="card"><table class="data-table"><thead><tr><th>Title</th><th>Customer</th><th>Status</th><th>Type</th><th>Service</th><th>Asset</th><th>Location</th><th>Quote</th></tr></thead><tbody><% workOrders.forEach(w=>{ %><tr><td><%= w.title %></td><td><%= w.customer %></td><td><%= w.status %></td><td><%= w.work_order_type || '—' %></td><td><%= w.service_line %></td><td><%= w.asset || '—' %></td><td><%= [w.city,w.state].filter(Boolean).join(', ') || '—' %></td><td><%= formatCurrency(w.quoted_price) %></td></tr><% }) %><% if(!workOrders.length){ %><tr><td colspan="8">No work orders.</td></tr><% } %></tbody></table></section>
<%- include('../partials-footer') %>
