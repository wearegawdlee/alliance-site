<%- include('../partials-header', { title: 'Work Orders' }) %>
<section class="page-header"><div><h1>Work Orders</h1><p>Dispatch, field notes, completion, and invoice generation.</p></div></section>
<section class="card"><table class="data-table"><thead><tr><th>Title</th><th>Customer</th><th>Status</th><th>Assigned</th><th>Scheduled</th><th>Service</th><th>Quote</th></tr></thead><tbody><% workOrders.forEach(w=>{ %><tr><td><a href="<%= routePath('/work-orders/' + w.id) %>"><%= w.title %></a></td><td><%= w.customer %></td><td><span class="badge"><%= w.status %></span></td><td><%= w.assigned_to || '—' %></td><td><%= formatDate(w.scheduled_start_at) %></td><td><%= w.service_line %></td><td><%= formatCurrency(w.quoted_price) %></td></tr><% }) %><% if(!workOrders.length){ %><tr><td colspan="7">No work orders yet.</td></tr><% } %></tbody></table></section>
<%- include('../partials-footer') %>
