<%- include('../partials-header', { title: 'Work Orders' }) %>
<section class="page-header"><div><h1>Work Orders</h1><p>Operational queue, dispatch, inspection items, and billing handoff.</p></div></section>
<section class="card">
  <form class="filter-form" method="get" action="<%= routePath('/work-orders') %>">
    <label>Search<input name="search" value="<%= query.search || '' %>" placeholder="Customer, city, service, title, notes..."></label>
    <label>Status<select name="status_id"><option value="">All statuses</option><% filters.statuses.forEach(s=>{ %><option value="<%= s.id %>" <%= String(query.status_id||'')===String(s.id) ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label>
    <label>Service<select name="service_line_id"><option value="">All services</option><% filters.serviceLines.forEach(s=>{ %><option value="<%= s.id %>" <%= String(query.service_line_id||'')===String(s.id) ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label>
    <label>Assigned<select name="assigned_user_id"><option value="">Anyone</option><option value="unassigned" <%= query.assigned_user_id==='unassigned' ? 'selected' : '' %>>Unassigned</option><% filters.users.forEach(u=>{ %><option value="<%= u.id %>" <%= String(query.assigned_user_id||'')===String(u.id) ? 'selected' : '' %>><%= u.display_name %></option><% }) %></select></label>
    <div class="filter-actions"><button class="button primary">Filter</button><a class="button secondary" href="<%= routePath('/work-orders') %>">Reset</a></div>
  </form>
</section>
<section class="card"><table class="data-table"><thead><tr><th>Title</th><th>Customer</th><th>Status</th><th>Assigned</th><th>Scheduled</th><th>Service</th><th>Items</th><th>Item Total</th></tr></thead><tbody><% workOrders.forEach(w=>{ %><tr><td><a href="<%= routePath('/work-orders/' + w.id) %>"><%= w.title %></a><br><span class="muted"><%= w.work_order_type || 'General' %></span></td><td><%= w.customer %><br><span class="muted"><%= [w.city,w.state].filter(Boolean).join(', ') %></span></td><td><span class="badge"><%= w.status %></span></td><td><%= w.assigned_to || '—' %></td><td><%= formatDate(w.scheduled_start_at) %></td><td><%= w.service_line %></td><td><%= w.item_count || 0 %></td><td><%= formatCurrency(w.item_total) %></td></tr><% }) %><% if(!workOrders.length){ %><tr><td colspan="8">No work orders match your filters.</td></tr><% } %></tbody></table></section>
<%- include('../partials-footer') %>
