<%- include('../partials-header', { title: 'Customers' }) %>
<section class="page-header">
  <div>
    <h1>Customers</h1>
    <p>Active and historical customer accounts. New leads live in Prospects until a work order is created.</p>
  </div>
  <a class="button primary" href="<%= routePath('/customers/new') %>">New Customer</a>
</section>

<section class="card">
  <h2>Search / Filter</h2>
  <form method="get" action="<%= routePath('/customers') %>" class="filter-form">
    <label>
      Search
      <input
        name="q"
        value="<%= filters.q || '' %>"
        placeholder="Name, phone, email, address, city..."
      >
    </label>
    <label>
      Service
      <select name="service_line_id">
        <option value="">All services</option>
        <% options.services.forEach(s=>{ %>
          <option value="<%= s.id %>" <%= Number(filters.service_line_id) === Number(s.id) ? 'selected' : '' %>><%= s.name %></option>
        <% }) %>
      </select>
    </label>
    <label>
      Owner
      <select name="assigned_user_id">
        <option value="">Anyone</option>
        <% options.users.forEach(u=>{ %>
          <option value="<%= u.id %>" <%= Number(filters.assigned_user_id) === Number(u.id) ? 'selected' : '' %>><%= u.display_name %></option>
        <% }) %>
      </select>
    </label>
    <label>
      Source
      <select name="lead_source_id">
        <option value="">Any source</option>
        <% options.sources.forEach(s=>{ %>
          <option value="<%= s.id %>" <%= Number(filters.lead_source_id) === Number(s.id) ? 'selected' : '' %>><%= s.name %></option>
        <% }) %>
      </select>
    </label>
    <div class="filter-actions">
      <button class="button primary">Apply</button>
      <a class="button secondary" href="<%= routePath('/customers') %>">Reset</a>
    </div>
  </form>
</section>

<section class="card">
  <div class="section-title-row">
    <h2>Customer Records</h2>
    <span class="muted"><%= customers.length %> shown</span>
  </div>
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Services</th>
        <th>Location</th>
        <th>Phone</th>
        <th>Email</th>
        <th>Owner</th>
        <th>Source</th>
      </tr>
    </thead>
    <tbody>
      <% if(!customers.length){ %>
        <tr><td colspan="8">No customers found.</td></tr>
      <% } %>
      <% customers.forEach(c=>{ %>
        <tr>
          <td>
            <a href="<%= routePath('/customers/' + c.id) %>"><%= c.display_name %></a>
            <% if(c.company_name){ %><br><small><%= c.company_name %></small><% } %>
          </td>
          <td><%= c.services || '—' %></td>
          <td><%= [c.address_line_1,c.city,c.state].filter(Boolean).join(', ') || '—' %></td>
          <td><%= c.phone || '—' %></td>
          <td><%= c.email || '—' %></td>
          <td><%= c.assigned_to || '—' %></td>
          <td><%= c.lead_source || '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('../partials-footer') %>
