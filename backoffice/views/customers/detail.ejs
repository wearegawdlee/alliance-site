<%- include('../partials-header', { title: customer.display_name }) %>
<section class="page-header"><div><h1><%= customer.display_name %></h1><p><span class="badge"><%= customer.status_code === 'prospect' ? 'Prospect' : 'Customer' %></span> <% if(customer.lead_source){ %> · Source: <%= customer.lead_source %><% } %><% if(customer.assigned_to){ %> · Owner: <%= customer.assigned_to %><% } %></p></div><div class="button-row"><a class="button secondary" href="<%= routePath(customer.status_code === 'prospect' ? '/prospects' : '/customers') %>">Back</a><a class="button secondary" href="<%= routePath('/payments/customers/' + customer.id) %>">Payment Settings</a><a class="button primary" href="<%= routePath('/customers/' + customer.id + '/edit') %>">Edit</a><% if(!customer.workOrders.length && !customer.estimates.length && !customer.invoices.length){ %><form method="post" action="<%= routePath('/customers/' + customer.id + '/delete') %>" onsubmit="return confirm('Delete this record? This cannot be undone.');"><button class="button danger">Delete</button></form><% } %></div></section>
<% if(customer.status_code === 'prospect'){ %>
<section class="card"><h2>Prospect Handling</h2><p class="muted">This record will become a customer automatically when the first work order is created. Until then, ownership and contact notes are managed from the Prospects queue.</p><div class="button-row"><a class="button primary" href="<%= routePath('/prospects') %>">Open Prospects Queue</a></div></section>
<% } %>
<div class="grid two"><section class="card"><h2>Contact</h2><% customer.contacts.forEach(c=>{ %><p><strong><%= [c.first_name,c.last_name].filter(Boolean).join(' ') || 'Contact' %></strong><br><%= c.phone || '—' %><br><%= c.email || '—' %><br><small><%= c.preferred_contact_method || '' %></small></p><% }) %></section><section class="card"><h2>Service Lines</h2><div class="chip-row"><% customer.services.forEach(s=>{ %><span class="chip"><%= s.name %></span><% }) %></div></section></div>
<section class="card">
  <div class="section-title-row"><div><h2>Customer Pricing</h2><p class="muted">Use this for customer-specific agreed rates, such as existing weekly pool service pricing. These rates override the catalog price when adding catalog items to work orders.</p></div></div>
  <table class="data-table"><thead><tr><th>Service</th><th>Catalog Item</th><th>Catalog Price</th><th>Customer Rate</th><th>Reason</th><th></th></tr></thead><tbody>
    <% (customer.pricing || []).forEach(p=>{ %><tr><td><%= p.service_line || '—' %></td><td><%= p.sku ? p.sku + ' · ' : '' %><%= p.catalog_item_name %><br><span class="muted"><%= p.category_name || '' %></span></td><td><%= formatCurrency(p.catalog_unit_price) %></td><td><strong><%= formatCurrency(p.override_unit_price) %></strong></td><td><%= p.reason || '—' %></td><td><form method="post" action="<%= routePath('/customers/' + customer.id + '/pricing/' + p.id + '/delete') %>" onsubmit="return confirm('Remove this customer price?');"><button class="button secondary">Remove</button></form></td></tr><% }) %>
    <% if(!(customer.pricing || []).length){ %><tr><td colspan="6">No customer-specific prices yet.</td></tr><% } %>
  </tbody></table>
  <h3>Add / Update Customer Rate</h3>
  <form method="post" action="<%= routePath('/customers/' + customer.id + '/pricing') %>" class="form-grid">
    <label>Catalog Item<select name="catalog_item_id" required><option value="">Select catalog item</option><% options.catalogItems.forEach(i=>{ %><option value="<%= i.id %>"><%= i.service_line ? i.service_line + ' · ' : '' %><%= i.category_name ? i.category_name + ' · ' : '' %><%= i.sku ? i.sku + ' · ' : '' %><%= i.name %> (<%= formatCurrency(i.unit_price) %>)</option><% }) %></select></label>
    <div class="grid two"><label>Customer Rate<input name="override_unit_price" type="number" step="0.01" required></label><label>Reason<input name="reason" placeholder="Existing agreed rate, pool size, legacy pricing, etc."></label></div>
    <button class="button primary">Save Customer Rate</button>
  </form>
</section>
<section class="card"><h2>Create Work Order</h2><p class="muted"><%= customer.status_code === 'prospect' ? 'Creating the first work order automatically moves this record out of Prospects and into Customers.' : 'Create an open work order for this customer.' %></p><form method="post" action="<%= routePath('/customers/' + customer.id + '/work-orders') %>" class="form-grid"><div class="grid two"><label>Title<input name="title" required placeholder="Service call"></label><label>Service Line<select name="service_line_id" required><% (customer.services.length ? customer.services : options.services).forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></label></div><div class="grid two"><label>Type<select name="work_order_type_id"><option value="">—</option><% options.workOrderTypes.forEach(t=>{ %><option value="<%= t.id %>"><%= t.service_line %> — <%= t.name %></option><% }) %></select></label><label>Assign Technician<select name="assigned_user_id"><option value="">Unassigned</option><% options.users.forEach(u=>{ %><option value="<%= u.id %>"><%= u.display_name %></option><% }) %></select></label></div><div class="grid two"><label>Location<select name="customer_location_id"><% customer.locations.forEach(l=>{ %><option value="<%= l.id %>"><%= l.label %> — <%= [l.city,l.state].filter(Boolean).join(', ') %></option><% }) %></select></label><label>Scheduled Start<input type="text" class="js-datetime-picker" name="scheduled_start_at" placeholder="YYYY-MM-DD HH:MM"></label></div><div class="grid two"><label>Quoted Price<input name="quoted_price" type="number" step="0.01"></label><label>Asset<select name="asset_id"><option value="">—</option><% customer.assets.forEach(a=>{ %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select></label></div><label class="check"><input type="checkbox" name="is_recurring" id="repeatWorkCheckbox" value="1"> Repeat this work</label><div id="recurringWorkFields" class="card subtle-card" style="display:none;"><h4>Recurring Schedule</h4><p class="muted">Uses the Scheduled Start above as the first visit. The recurring plan will point to the next future visit after this work order is created.</p><div class="grid two"><label>Frequency<select name="frequency"><option value="weekly">Weekly</option><option value="biweekly">Biweekly</option><option value="monthly">Monthly</option></select></label><label>Every<input type="number" min="1" step="1" name="interval_count" value="1"></label></div><div class="grid two"><label>Day of Month<input type="number" min="1" max="31" name="day_of_month" placeholder="Optional"></label><p class="muted">Calendar note: choose the first visit using Scheduled Start.</p></div></div><label>Description<textarea name="description"><%= customer.notes_summary || '' %></textarea></label><button class="button primary">Create Work Order</button></form></section>
<section class="card"><h2>Locations</h2><table class="data-table"><thead><tr><th>Label</th><th>Type</th><th>Address</th><th>Access</th></tr></thead><tbody><% customer.locations.forEach(l=>{ %><tr><td><%= l.label %></td><td><%= l.property_type || '—' %></td><td><%= [l.address_line_1,l.city,l.state,l.postal_code].filter(Boolean).join(', ') || '—' %></td><td><%= l.access_notes || l.gate_code || '—' %></td></tr><% }) %><% if(!customer.locations.length){ %><tr><td colspan="4">No locations.</td></tr><% } %></tbody></table></section>
<section class="card"><h2>Work Orders</h2><table class="data-table"><thead><tr><th>Title</th><th>Type</th><th>Status</th><th>Assigned</th><th>Service</th><th>Quote</th></tr></thead><tbody><% customer.workOrders.forEach(w=>{ %><tr><td><a href="<%= routePath('/work-orders/' + w.id) %>"><%= w.title %></a></td><td><%= w.work_order_type || '—' %></td><td><span class="badge"><%= w.status %></span></td><td><%= w.assigned_to || '—' %></td><td><%= w.service_line %></td><td><%= formatCurrency(w.quoted_price) %></td></tr><% }) %><% if(!customer.workOrders.length){ %><tr><td colspan="6">No work orders.</td></tr><% } %></tbody></table></section>
<div class="grid two"><section class="card"><h2>Estimates</h2><table class="data-table"><thead><tr><th>#</th><th>Status</th><th>Total</th></tr></thead><tbody><% customer.estimates.forEach(e=>{ %><tr><td><%= e.estimate_number || ('#' + e.id) %></td><td><%= e.status %></td><td><%= formatCurrency(e.total_amount) %></td></tr><% }) %><% if(!customer.estimates.length){ %><tr><td colspan="3">No estimates.</td></tr><% } %></tbody></table></section><section class="card"><h2>Invoices</h2><table class="data-table"><thead><tr><th>#</th><th>Status</th><th>Total</th></tr></thead><tbody><% customer.invoices.forEach(i=>{ %><tr><td><%= i.invoice_number || ('#' + i.id) %></td><td><%= i.status %></td><td><%= formatCurrency(i.total_amount) %></td></tr><% }) %><% if(!customer.invoices.length){ %><tr><td colspan="3">No invoices.</td></tr><% } %></tbody></table></section></div>
<section class="card"><h2>Notes</h2><form method="post" action="<%= routePath('/customers/' + customer.id + '/notes') %>" class="note-form"><textarea name="note_body" placeholder="Add a note..."></textarea><button class="button primary">Add Note</button></form><% customer.notes.forEach(n=>{ %><div class="note"><%= n.note_body %><small><%= n.author || 'System' %> · <%= formatDate(n.created_at) %></small></div><% }) %></section>
<section class="card"><h2>Lifecycle History</h2><table class="data-table"><thead><tr><th>When</th><th>From</th><th>To</th><th>By</th><th>Reason</th></tr></thead><tbody><% customer.statusHistory.forEach(h=>{ %><tr><td><%= formatDate(h.created_at) %></td><td><%= h.from_status || '—' %></td><td><%= h.to_status %></td><td><%= h.changed_by || 'System' %></td><td><%= h.reason || '—' %></td></tr><% }) %></tbody></table></section>

<script>
document.addEventListener('DOMContentLoaded', function(){
  const repeatCheckbox = document.getElementById('repeatWorkCheckbox');
  const recurringFields = document.getElementById('recurringWorkFields');
  if(!repeatCheckbox || !recurringFields) return;

  const scheduledStart = document.querySelector('[name="scheduled_start_at"]');

  function syncRecurringFields(){
    recurringFields.style.display = repeatCheckbox.checked ? '' : 'none';
    if(scheduledStart){
      scheduledStart.required = repeatCheckbox.checked;
    }
  }

  repeatCheckbox.addEventListener('change', syncRecurringFields);
  syncRecurringFields();
});
</script>
<%- include('../partials-footer') %>
