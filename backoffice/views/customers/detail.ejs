<%- include('../partials-header', { title: customer.display_name }) %>
<section class="page-header"><div><h1><%= customer.display_name %></h1><p><span class="badge"><%= customer.status %></span> <% if(customer.lead_source){ %> · Source: <%= customer.lead_source %><% } %><% if(customer.assigned_to){ %> · Owner: <%= customer.assigned_to %><% } %></p></div><div class="button-row"><a class="button secondary" href="<%= routePath('/customers') %>">Back</a><a class="button primary" href="<%= routePath('/customers/' + customer.id + '/edit') %>">Edit</a><% if(!customer.workOrders.length && !customer.estimates.length && !customer.invoices.length){ %><form method="post" action="<%= routePath('/customers/' + customer.id + '/delete') %>" onsubmit="return confirm('Delete this customer record? This cannot be undone.');"><button class="button danger">Delete</button></form><% } %></div></section>
<section class="card workflow-card"><h2>Customer Workflow</h2><div class="workflow-steps"><div class="step <%= customer.status_code === 'prospect' ? 'active' : '' %>">1. Prospect</div><div class="step <%= customer.status_code === 'customer' ? 'active' : '' %>">2. Customer</div><div class="step <%= ['lost','inactive'].includes(customer.status_code) ? 'active' : '' %>">Lost / Inactive</div></div><p class="muted">Contact made is recorded as an event. Creating a work order is the normal conversion point from Prospect to Customer.</p><div class="button-row"><form method="post" action="<%= routePath('/customers/' + customer.id + '/transition') %>"><input type="hidden" name="action" value="contacted"><button class="button secondary">Log Contact Made</button></form><form method="post" action="<%= routePath('/customers/' + customer.id + '/transition') %>"><input type="hidden" name="action" value="lost"><button class="button secondary">Mark Lost</button></form></div></section>
<div class="grid two"><section class="card"><h2>Contact</h2><% customer.contacts.forEach(c=>{ %><p><strong><%= [c.first_name,c.last_name].filter(Boolean).join(' ') || 'Contact' %></strong><br><%= c.phone || '—' %><br><%= c.email || '—' %><br><small><%= c.preferred_contact_method || '' %></small></p><% }) %></section><section class="card"><h2>Service Lines</h2><div class="chip-row"><% customer.services.forEach(s=>{ %><span class="chip"><%= s.name %></span><% }) %></div></section></div>
<section class="card"><h2>Create Work Order</h2><p class="muted">Use this when the customer says “yes, please come out.” This converts the prospect to a customer and creates an Open work order.</p><form method="post" action="<%= routePath('/customers/' + customer.id + '/work-orders') %>" class="form-grid"><div class="grid two"><label>Title<input name="title" required placeholder="Service call"></label><label>Service Line<select name="service_line_id" required><% (customer.services.length ? customer.services : options.services).forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></label></div><div class="grid two"><label>Type<select name="work_order_type_id"><option value="">—</option><% options.workOrderTypes.forEach(t=>{ %><option value="<%= t.id %>"><%= t.service_line %> — <%= t.name %></option><% }) %></select></label><label>Assign Technician<select name="assigned_user_id"><option value="">Unassigned</option><% options.users.forEach(u=>{ %><option value="<%= u.id %>"><%= u.display_name %></option><% }) %></select></label></div><div class="grid two"><label>Location<select name="customer_location_id"><% customer.locations.forEach(l=>{ %><option value="<%= l.id %>"><%= l.label %> — <%= [l.city,l.state].filter(Boolean).join(', ') %></option><% }) %></select></label><label>Scheduled Start<input type="text" class="js-datetime-picker" name="scheduled_start_at" placeholder="YYYY-MM-DD HH:MM"></label></div><div class="grid two"><label>Quoted Price<input name="quoted_price" type="number" step="0.01"></label><label>Asset<select name="asset_id"><option value="">—</option><% customer.assets.forEach(a=>{ %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select></label></div><label class="check"><input type="checkbox" name="is_recurring" id="repeatWorkCheckbox" value="1"> Repeat this work</label><div id="recurringWorkFields" class="card subtle-card" style="display:none;"><h4>Recurring Schedule</h4><p class="muted">Uses the Scheduled Start above as the first visit. The recurring plan will point to the next future visit after this work order is created.</p><div class="grid two"><label>Frequency<select name="frequency"><option value="weekly">Weekly</option><option value="biweekly">Biweekly</option><option value="monthly">Monthly</option></select></label><label>Every<input type="number" min="1" step="1" name="interval_count" value="1"></label></div><div class="grid two"><label>Day of Month<input type="number" min="1" max="31" name="day_of_month" placeholder="Optional"></label><p class="muted">Calendar note: choose the first visit using Scheduled Start.</p></div></div><label>Description<textarea name="description"><%= customer.notes_summary || '' %></textarea></label><button class="button primary">Create Work Order</button></form></section>
<section class="card"><h2>Locations</h2><table class="data-table"><thead><tr><th>Label</th><th>Type</th><th>Address</th><th>Access</th></tr></thead><tbody><% customer.locations.forEach(l=>{ %><tr><td><%= l.label %></td><td><%= l.property_type || '—' %></td><td><%= [l.address_line_1,l.city,l.state,l.postal_code].filter(Boolean).join(', ') || '—' %></td><td><%= l.access_notes || l.gate_code || '—' %></td></tr><% }) %><% if(!customer.locations.length){ %><tr><td colspan="4">No locations.</td></tr><% } %></tbody></table></section>
<section class="card"><h2>Work Orders</h2><table class="data-table"><thead><tr><th>Title</th><th>Type</th><th>Status</th><th>Assigned</th><th>Service</th><th>Quote</th></tr></thead><tbody><% customer.workOrders.forEach(w=>{ %><tr><td><a href="<%= routePath('/work-orders/' + w.id) %>"><%= w.title %></a></td><td><%= w.work_order_type || '—' %></td><td><span class="badge"><%= w.status %></span></td><td><%= w.assigned_to || '—' %></td><td><%= w.service_line %></td><td><%= formatCurrency(w.quoted_price) %></td></tr><% }) %><% if(!customer.workOrders.length){ %><tr><td colspan="6">No work orders.</td></tr><% } %></tbody></table></section>
<div class="grid two"><section class="card"><h2>Estimates</h2><table class="data-table"><thead><tr><th>#</th><th>Status</th><th>Total</th></tr></thead><tbody><% customer.estimates.forEach(e=>{ %><tr><td><%= e.estimate_number || ('#' + e.id) %></td><td><%= e.status %></td><td><%= formatCurrency(e.total_amount) %></td></tr><% }) %><% if(!customer.estimates.length){ %><tr><td colspan="3">No estimates.</td></tr><% } %></tbody></table></section><section class="card"><h2>Invoices</h2><table class="data-table"><thead><tr><th>#</th><th>Status</th><th>Total</th></tr></thead><tbody><% customer.invoices.forEach(i=>{ %><tr><td><%= i.invoice_number || ('#' + i.id) %></td><td><%= i.status %></td><td><%= formatCurrency(i.total_amount) %></td></tr><% }) %><% if(!customer.invoices.length){ %><tr><td colspan="3">No invoices.</td></tr><% } %></tbody></table></section></div>
<section class="card"><h2>Notes</h2><form method="post" action="<%= routePath('/customers/' + customer.id + '/notes') %>" class="note-form"><textarea name="note_body" placeholder="Add a note..."></textarea><button class="button primary">Add Note</button></form><% customer.notes.forEach(n=>{ %><div class="note"><%= n.note_body %><small><%= n.author || 'System' %> · <%= formatDate(n.created_at) %></small></div><% }) %></section>
<section class="card"><h2>Status History</h2><table class="data-table"><thead><tr><th>When</th><th>From</th><th>To</th><th>By</th><th>Reason</th></tr></thead><tbody><% customer.statusHistory.forEach(h=>{ %><tr><td><%= formatDate(h.created_at) %></td><td><%= h.from_status || '—' %></td><td><%= h.to_status %></td><td><%= h.changed_by || 'System' %></td><td><%= h.reason || '—' %></td></tr><% }) %></tbody></table></section>

<script>
document.addEventListener('DOMContentLoaded', function(){
  const repeatCheckbox = document.getElementById('repeatWorkCheckbox');
  const recurringFields = document.getElementById('recurringWorkFields');
  if(!repeatCheckbox || !recurringFields) return;

  const scheduledStart = document.querySelector('[name="scheduled_start_at"]');

  function syncRecurringFields(){
    recurringFields.style.display = repeatCheckbox.checked ? '' : 'none';
    if(scheduledStart){
      scheduledStart.required = repeatCheckbox.checked;
    }
  }

  repeatCheckbox.addEventListener('change', syncRecurringFields);
  syncRecurringFields();
});
</script>
<%- include('../partials-footer') %>
