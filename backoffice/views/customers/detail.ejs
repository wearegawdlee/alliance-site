<%- include('../partials-header', { title: customer.display_name }) %>
<section class="page-header"><div><h1><%= customer.display_name %></h1><p><%= customer.status %> <% if(customer.lead_source){ %> · Source: <%= customer.lead_source %><% } %></p></div><a class="button secondary" href="<%= routePath('/customers') %>">Back</a></section>
<div class="grid two"><section class="card"><h2>Contact</h2><% customer.contacts.forEach(c=>{ %><p><strong><%= [c.first_name,c.last_name].filter(Boolean).join(' ') || 'Contact' %></strong><br><%= c.phone || '—' %><br><%= c.email || '—' %></p><% }) %></section><section class="card"><h2>Service Lines</h2><div class="chip-row"><% customer.services.forEach(s=>{ %><span class="chip"><%= s.name %></span><% }) %></div></section></div>
<section class="card"><h2>Locations</h2><table class="data-table"><thead><tr><th>Label</th><th>Type</th><th>Address</th><th>Access</th></tr></thead><tbody><% customer.locations.forEach(l=>{ %><tr><td><%= l.label %></td><td><%= l.property_type || '—' %></td><td><%= [l.address_line_1,l.city,l.state,l.postal_code].filter(Boolean).join(', ') || '—' %></td><td><%= l.access_notes || l.gate_code || '—' %></td></tr><% }) %><% if(!customer.locations.length){ %><tr><td colspan="4">No locations.</td></tr><% } %></tbody></table></section>
<section class="card"><h2>Assets</h2><table class="data-table"><thead><tr><th>Name</th><th>Type</th><th>Service</th><th>Model</th></tr></thead><tbody><% customer.assets.forEach(a=>{ %><tr><td><%= a.name %></td><td><%= a.asset_type || '—' %></td><td><%= a.service_line %></td><td><%= [a.manufacturer,a.model].filter(Boolean).join(' ') || '—' %></td></tr><% }) %><% if(!customer.assets.length){ %><tr><td colspan="4">No assets.</td></tr><% } %></tbody></table></section>
<section class="card"><h2>Work Orders</h2><table class="data-table"><thead><tr><th>Title</th><th>Type</th><th>Status</th><th>Service</th><th>Asset</th><th>Quote</th></tr></thead><tbody><% customer.workOrders.forEach(w=>{ %><tr><td><%= w.title %></td><td><%= w.work_order_type || '—' %></td><td><%= w.status %></td><td><%= w.service_line %></td><td><%= w.asset || '—' %></td><td><%= formatCurrency(w.quoted_price) %></td></tr><% }) %><% if(!customer.workOrders.length){ %><tr><td colspan="6">No work orders.</td></tr><% } %></tbody></table></section>
<div class="grid two"><section class="card"><h2>Estimates</h2><table class="data-table"><thead><tr><th>#</th><th>Status</th><th>Total</th></tr></thead><tbody><% customer.estimates.forEach(e=>{ %><tr><td><%= e.estimate_number || ('#' + e.id) %></td><td><%= e.status %></td><td><%= formatCurrency(e.total_amount) %></td></tr><% }) %><% if(!customer.estimates.length){ %><tr><td colspan="3">No estimates.</td></tr><% } %></tbody></table></section><section class="card"><h2>Invoices</h2><table class="data-table"><thead><tr><th>#</th><th>Status</th><th>Total</th></tr></thead><tbody><% customer.invoices.forEach(i=>{ %><tr><td><%= i.invoice_number || ('#' + i.id) %></td><td><%= i.status %></td><td><%= formatCurrency(i.total_amount) %></td></tr><% }) %><% if(!customer.invoices.length){ %><tr><td colspan="3">No invoices.</td></tr><% } %></tbody></table></section></div>
<section class="card"><h2>Notes</h2><form method="post" action="<%= routePath('/customers/' + customer.id + '/notes') %>" class="note-form"><textarea name="note_body" placeholder="Add a note..."></textarea><button class="button primary">Add Note</button></form><% customer.notes.forEach(n=>{ %><div class="note"><%= n.note_body %><small><%= n.author || 'System' %> · <%= formatDate(n.created_at) %></small></div><% }) %></section>
<%- include('../partials-footer') %>
