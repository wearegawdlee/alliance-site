<%- include('../partials-header', { title }) %>
<% const isEdit = !!customer; const primaryContact = customer?.contacts?.[0] || {}; const primaryLocation = customer?.locations?.[0] || {}; const selectedServices = new Set((customer?.services || []).map(s => String(s.id))); %>
<section class="page-header"><div><h1><%= isEdit ? 'Edit Customer' : 'New Customer' %></h1><p><%= isEdit ? 'Update contact, location, service, and account details.' : 'Create an active customer record for someone already being served.' %></p></div><% if(isEdit){ %><a class="button secondary" href="<%= routePath('/customers/' + customer.id) %>">Back</a><% } %></section>
<form method="post" action="<%= isEdit ? routePath('/customers/' + customer.id) : routePath('/customers') %>" class="card form-grid">
  <label>Display Name<input name="display_name" required value="<%= customer?.display_name || '' %>"></label>
  <label>Assigned To<select name="assigned_user_id"><option value="">—</option><% options.users.forEach(o=>{ %><option value="<%= o.id %>" <%= customer && Number(customer.assigned_user_id)===Number(o.id) ? 'selected' : '' %>><%= o.display_name %></option><% }) %></select></label>
  <div class="grid two"><label>Lead Source<select name="lead_source_id"><option value="">—</option><% options.sources.forEach(o=>{ %><option value="<%= o.id %>" <%= customer && Number(customer.lead_source_id)===Number(o.id) ? 'selected' : '' %>><%= o.name %></option><% }) %></select></label><label>Company Name<input name="company_name" value="<%= customer?.company_name || '' %>"></label></div>
  <div class="grid two"><label>First Name<input name="first_name" value="<%= primaryContact.first_name || '' %>"></label><label>Last Name<input name="last_name" value="<%= primaryContact.last_name || '' %>"></label></div>
  <div class="grid two"><label>Phone<input name="phone" value="<%= primaryContact.phone || '' %>"></label><label>Email<input name="email" type="email" value="<%= primaryContact.email || '' %>"></label></div>
  <label>Preferred Contact Method<input name="preferred_contact_method" value="<%= primaryContact.preferred_contact_method || '' %>"></label>
  <label>Service Lines</label><div class="chip-row check-row"><% options.services.forEach(o=>{ %><label class="check"><input type="checkbox" name="service_line_ids" value="<%= o.id %>" <%= selectedServices.has(String(o.id)) ? 'checked' : '' %>> <%= o.name %></label><% }) %></div>
  <div class="grid two"><label>Location Label<input name="location_label" value="<%= primaryLocation.label || 'Service Location' %>"></label><label>Property Type<select name="property_type_id"><option value="">—</option><% options.propertyTypes.forEach(o=>{ %><option value="<%= o.id %>" <%= Number(primaryLocation.property_type_id)===Number(o.id) ? 'selected' : '' %>><%= o.name %></option><% }) %></select></label></div>
  <div class="grid two"><label>Address<input name="address_line_1" value="<%= primaryLocation.address_line_1 || '' %>"></label><label>City<input name="city" value="<%= primaryLocation.city || 'Roswell' %>"></label></div>
  <div class="grid three"><label>State<input name="state" value="<%= primaryLocation.state || 'GA' %>"></label><label>County<input name="county" value="<%= primaryLocation.county || '' %>" placeholder="Fulton"></label><label>Postal Code<input name="postal_code" value="<%= primaryLocation.postal_code || '' %>"></label></div>
  <div class="grid two"><label>Gate Code<input name="gate_code" value="<%= primaryLocation.gate_code || '' %>"></label><label>Access Notes<input name="access_notes" value="<%= primaryLocation.access_notes || '' %>"></label></div>
  <label>Summary Notes<textarea name="notes_summary"><%= customer?.notes_summary || '' %></textarea></label>
  <% if(!isEdit){ %><label>Initial Note<textarea name="initial_note"></textarea></label><% } %>
  <button class="button primary"><%= isEdit ? 'Save Customer' : 'Create Customer' %></button>
</form>
<%- include('../partials-footer') %>
