<%- include('../partials-header', { title: 'New Customer' }) %>
<section class="page-header"><div><h1>New Customer</h1><p>Create a prospect or customer across one or more service lines.</p></div></section>
<form method="post" action="<%= routePath('/customers') %>" class="card form-grid"><label>Display Name<input name="display_name" required></label><div class="grid two"><label>Status<select name="customer_status_id" required><% options.statuses.forEach(o=>{ %><option value="<%= o.id %>"><%= o.name %></option><% }) %></select></label><label>Lead Source<select name="lead_source_id"><option value="">—</option><% options.sources.forEach(o=>{ %><option value="<%= o.id %>"><%= o.name %></option><% }) %></select></label></div><div class="grid two"><label>First Name<input name="first_name"></label><label>Last Name<input name="last_name"></label></div><div class="grid two"><label>Phone<input name="phone"></label><label>Email<input name="email" type="email"></label></div><label>Service Lines</label><div class="chip-row check-row"><% options.services.forEach(o=>{ %><label class="check"><input type="checkbox" name="service_line_ids" value="<%= o.id %>"> <%= o.name %></label><% }) %></div><div class="grid two"><label>Address<input name="address_line_1"></label><label>City<input name="city" value="Roswell"></label></div><div class="grid two"><label>State<input name="state" value="GA"></label><label>Postal Code<input name="postal_code"></label></div><label>Initial Note<textarea name="initial_note"></textarea></label><button class="button primary">Create Customer</button></form>
<%- include('../partials-footer') %>
