<%- include('../partials-header') %>
<section class="page-header">
  <div>
    <h1>Prospects</h1>
    <p>New leads that need ownership, contact, and notes before they either become customers through work or get deleted.</p>
  </div>
</section>

<section class="card">
  <form class="filter-form" method="get">
    <label>Search<input name="q" value="<%= filters.q || '' %>" placeholder="Name, phone, email, address"></label>
    <label>Owner<select name="assigned_user_id">
      <option value="">Anyone</option>
      <% users.forEach(u=>{ %><option value="<%= u.id %>" <%= String(filters.assigned_user_id||'')===String(u.id) ? 'selected' : '' %>><%= u.display_name %></option><% }) %>
    </select></label>
    <div class="filter-actions"><button class="button primary">Filter</button><a class="button secondary" href="<%= routePath('/prospects') %>">Reset</a></div>
  </form>
</section>

<section class="card">
  <table class="data-table">
    <thead><tr><th>Prospect</th><th>Contact</th><th>Address</th><th>Owner</th><th>Status</th><th>Latest note</th><th>Actions</th></tr></thead>
    <tbody>
      <% prospects.forEach(p=>{ %>
        <tr>
          <td><a href="<%= routePath('/customers/' + p.id) %>"><strong><%= p.display_name %></strong></a><br><span class="muted"><%= p.lead_source || 'Unknown source' %> · <%= formatDate(p.created_at) %></span></td>
          <td><%= p.phone || '—' %><br><span class="muted"><%= p.email || '' %></span></td>
          <td><%= p.address_line_1 || '—' %><% if(p.city){ %><br><span class="muted"><%= p.city %>, <%= p.state || 'GA' %></span><% } %></td>
          <td><%= p.assigned_to || 'Unclaimed' %></td>
          <td>
            <% if(p.contacted_at){ %>
              <span class="badge">Contacted</span><br><span class="muted"><%= p.contacted_by || 'Someone' %> · <%= formatDate(p.contacted_at) %></span>
            <% } else { %>
              <span class="badge attention">Needs contact</span>
            <% } %>
          </td>
          <td><%= p.latest_note || '—' %><% if(p.latest_note_author){ %><br><span class="muted"><%= p.latest_note_author %> · <%= formatDate(p.latest_note_at) %></span><% } %></td>
          <td>
            <div class="stacked-actions">
              <% if(!p.assigned_to){ %><form method="post" action="<%= routePath('/prospects/' + p.id + '/claim') %>"><button class="button secondary full">Claim</button></form><% } %>
              <form method="post" action="<%= routePath('/prospects/' + p.id + '/contacted') %>">
                <textarea name="note_body" placeholder="Contact note"></textarea>
                <button class="button primary full">Mark Contacted</button>
              </form>
              <a class="button secondary full" href="<%= routePath('/customers/' + p.id + '/edit') %>">Edit Details</a>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if(!prospects.length){ %><tr><td colspan="7">No open prospects.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../partials-footer') %>
