<%- include('../partials-header') %>
<section class="page-header">
  <div>
    <h1>Prospects</h1>
    <p>Inbound service requests. Customers are created once; each new request becomes a lead attached to that customer.</p>
  </div>
</section>

<section class="card">
  <form class="filter-form" method="get">
    <label>Search<input name="q" value="<%= filters.q || '' %>" placeholder="Name, phone, email, address"></label>
    <label>Owner<select name="assigned_user_id">
      <option value="">Anyone</option>
      <% users.forEach(u=>{ %><option value="<%= u.id %>" <%= String(filters.assigned_user_id||'')===String(u.id) ? 'selected' : '' %>><%= u.display_name %></option><% }) %>
    </select></label>
    <div class="filter-actions"><button class="button primary">Filter</button><a class="button secondary" href="<%= routePath('/prospects') %>">Reset</a></div>
  </form>
</section>

<section class="card">
  <table class="data-table">
    <thead><tr><th>Lead / Customer</th><th>Contact</th><th>Address</th><th>Owner</th><th>Status</th><th>Latest note</th><th>Actions</th></tr></thead>
    <tbody>
      <% prospects.forEach(p=>{ %>
        <tr>
          <td><a href="<%= routePath('/customers/' + p.customer_id) %>"><strong><%= p.submitted_name || p.display_name %></strong></a><br><span class="muted"><%= p.requested_service_type || p.service_line || 'Service request' %> · <%= p.lead_source || 'Unknown source' %> · <%= formatDate(p.lead_created_at) %></span><br><span class="muted">Customer: <%= p.display_name %></span></td>
          <td><%= p.submitted_phone || p.phone || '—' %><br><span class="muted"><%= p.submitted_email || p.email || '' %></span></td>
          <td><%= p.submitted_address_line_1 || p.address_line_1 || '—' %><% if(p.submitted_city || p.city){ %><br><span class="muted"><%= p.submitted_city || p.city %>, <%= p.submitted_state || p.state || 'GA' %></span><% } %></td>
          <td><%= p.assigned_to || 'Unclaimed' %></td>
          <td>
            <% if(p.contacted_at){ %>
              <span class="badge">Contacted</span><br><span class="muted"><%= p.contacted_by || 'Someone' %> · <%= formatDate(p.contacted_at) %></span>
            <% } else { %>
              <span class="badge attention">Needs contact</span>
            <% } %>
            <% if(p.has_completed_work || p.has_paid_invoice){ %><br><span class="muted">Existing customer</span><% } %>
          </td>
          <td><%= p.latest_note || '—' %><% if(p.latest_note_author){ %><br><span class="muted"><%= p.latest_note_author %> · <%= formatDate(p.latest_note_at) %></span><% } %></td>
          <td>
            <div class="stacked-actions">
              <% if(!p.assigned_to){ %><form method="post" action="<%= routePath('/prospects/' + p.lead_id + '/claim') %>"><button class="button secondary full" data-loading-text="Claiming...">Claim</button></form><% } %>
              <form method="post" action="<%= routePath('/prospects/' + p.lead_id + '/contacted') %>">
                <textarea name="note_body" placeholder="Contact note"></textarea>
                <button class="button primary full" data-loading-text="Saving...">Mark Contacted</button>
              </form>
              <a class="button secondary full" href="<%= routePath('/customers/' + p.customer_id + '/edit') %>">Edit Customer</a>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if(!prospects.length){ %><tr><td colspan="7">No open prospects.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../partials-footer') %>
