<%- include('../partials-header', { title: 'Billing' }) %>
<section class="page-header">
  <div>
    <h1>Billing</h1>
    <p>Invoices and payment tracking.</p>
  </div>
</section>

<section class="card">
  <div class="section-title-row">
    <div>
      <h2>Invoices</h2>
      <p class="muted">Select unpaid invoices and send them in a batch. Payments are recorded from the invoice detail screen.</p>
    </div>
    <div class="button-row">
      <% const activeStatus = statusFilter || 'unpaid'; %>
      <a class="button <%= activeStatus === 'unpaid' ? 'primary' : 'secondary' %>" href="<%= routePath('/billing?status=unpaid') %>">Unpaid</a>
      <a class="button <%= activeStatus === 'paid' ? 'primary' : 'secondary' %>" href="<%= routePath('/billing?status=paid') %>">Paid</a>
      <a class="button <%= activeStatus === 'all' ? 'primary' : 'secondary' %>" href="<%= routePath('/billing?status=all') %>">All</a>
    </div>
  </div>

  <form method="post" action="<%= routePath('/billing/invoices/batch-submit') %>">
    <input type="hidden" name="status_filter" value="<%= statusFilter || 'unpaid' %>">
    <div class="button-row" style="margin-bottom: 1rem;">
      <button class="button primary" type="submit" data-loading-text="Sending...">Send Selected Invoices</button>
    </div>

    <table class="data-table">
      <thead>
        <tr>
          <th><input type="checkbox" id="selectAllInvoices"></th>
          <th>Invoice</th>
          <th>Customer</th>
          <th>Location</th>
          <th>Status</th>
          <th>Total</th>
          <th>Deposit</th>
          <th>Balance</th>
          <th>Paid</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% invoices.forEach(i=>{ %>
        <tr>
          <td>
            <% if(i.status_code !== 'paid'){ %>
              <input type="checkbox" class="invoice-checkbox" name="invoice_ids" value="<%= i.id %>">
            <% } %>
          </td>
          <td><a href="<%= routePath('/billing/invoices/' + i.id) %>"><%= i.invoice_number || ('#' + i.id) %></a></td>
          <td><a href="<%= routePath('/customers/' + i.customer_id) %>"><%= i.customer %></a></td>
          <td><%= [i.city,i.state].filter(Boolean).join(', ') || '—' %></td>
          <td><span class="badge"><%= i.status %></span></td>
          <td><%= formatCurrency(i.total_amount) %></td>
          <td><%= formatCurrency(i.deposit_amount || 0) %></td>
          <td><%= formatCurrency(i.balance_due || i.total_amount || 0) %></td>
          <td><%= formatCurrency(i.paid_amount) %></td>
          <td><a class="button secondary" href="<%= routePath('/billing/invoices/' + i.id) %>">Open</a></td>
        </tr>
        <% }) %>
        <% if(!invoices.length){ %><tr><td colspan="10">No invoices.</td></tr><% } %>
      </tbody>
    </table>
  </form>
</section>

<script>
document.addEventListener('DOMContentLoaded', function(){
  const selectAll = document.getElementById('selectAllInvoices');
  const checkboxes = Array.from(document.querySelectorAll('.invoice-checkbox'));
  if(!selectAll) return;
  selectAll.addEventListener('change', function(){
    checkboxes.forEach(cb => cb.checked = selectAll.checked);
  });
});
</script>

<%- include('../partials-footer') %>
