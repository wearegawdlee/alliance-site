<%- include('../partials-header', { title: 'Billing' }) %>
<section class="page-header"><div><h1>Billing</h1><p>Invoices and payment tracking.</p></div></section>
<section class="card">
  <table class="data-table">
    <thead><tr><th>Invoice</th><th>Customer</th><th>Location</th><th>Status</th><th>Total</th><th>Paid</th><th>Actions</th></tr></thead>
    <tbody>
      <% invoices.forEach(i=>{ %>
      <tr>
        <td><a href="<%= routePath('/billing/invoices/' + i.id) %>"><%= i.invoice_number || ('#' + i.id) %></a></td>
        <td><a href="<%= routePath('/customers/' + i.customer_id) %>"><%= i.customer %></a></td>
        <td><%= [i.city,i.state].filter(Boolean).join(', ') || '—' %></td>
        <td><span class="badge"><%= i.status %></span></td>
        <td><%= formatCurrency(i.total_amount) %></td>
        <td><%= formatCurrency(i.paid_amount) %></td>
        <td>
          <div class="button-row">
            <% if(i.status_code === 'created'){ %>
              <form method="post" action="<%= routePath('/billing/invoices/' + i.id + '/submit') %>" class="inline-form"><button class="button secondary">Submit</button></form>
            <% } %>
            <% if(i.status_code === 'submitted'){ %>
              <form method="post" action="<%= routePath('/billing/invoices/' + i.id + '/submit') %>" class="inline-form"><button class="button secondary">Send Reminder</button></form>
              <form method="post" action="<%= routePath('/billing/invoices/' + i.id + '/payments') %>" class="inline-form"><input type="number" step="0.01" name="amount" value="<%= Number(i.total_amount || 0) - Number(i.paid_amount || 0) %>"><select name="payment_method_id"><option value="">Method</option><% paymentMethods.forEach(m=>{ %><option value="<%= m.id %>"><%= m.name %></option><% }) %></select><button class="button secondary">Pay</button></form>
            <% } %>
            <% if(i.status_code === 'paid'){ %>Closed<% } %>
          </div>
        </td>
      </tr>
      <% }) %>
      <% if(!invoices.length){ %><tr><td colspan="7">No invoices.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../partials-footer') %>
