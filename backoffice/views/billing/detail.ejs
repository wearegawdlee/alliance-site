<%- include('../partials-header', { title: invoice.invoice.invoice_number || 'Invoice' }) %>
<% const paidTotal = invoice.payments.reduce((s,p)=>s+Number(p.amount||0),0); const storedBalance = Number(invoice.invoice.balance_due || 0); const computedBalance = Math.max(0, Number(invoice.invoice.total_amount || 0) - Number(invoice.invoice.deposit_amount || 0)); const payableBase = invoice.invoice.status_code === 'paid' ? 0 : Math.max(storedBalance, computedBalance); const amountDue = Math.max(0, payableBase - paidTotal); %>

<section class="page-header">
  <div><h1><%= invoice.invoice.invoice_number || ('Invoice #' + invoice.invoice.id) %></h1><p>Invoice detail and itemized charges.</p></div>
  <div class="button-row">
    <a class="button secondary" href="<%= routePath('/billing') %>">← Back to Billing</a>
    <a class="button secondary" href="<%= routePath('/billing/invoices/' + invoice.invoice.id + '/pdf') %>" target="_blank">Download PDF</a>
    <% if(invoice.invoice.status_code === 'created'){ %>
      <form method="POST" action="<%= routePath('/billing/invoices/' + invoice.invoice.id + '/submit') %>" class="inline-form"><button class="button primary" data-loading-text="Sending...">Submit</button></form>
    <% } %>
    <% if(['submitted','payment_failed'].includes(invoice.invoice.status_code)){ %>
      <form method="POST" action="<%= routePath('/billing/invoices/' + invoice.invoice.id + '/submit') %>" class="inline-form"><input type="hidden" name="resend" value="1"><button class="button secondary" data-loading-text="Sending...">Send Reminder</button></form>
      <form method="POST" action="<%= routePath('/payments/invoices/' + invoice.invoice.id + '/card-checkout') %>" class="inline-form"><button class="button primary" data-loading-text="Opening...">Send / Open Card Checkout</button></form>
      <form method="POST" action="<%= routePath('/payments/invoices/' + invoice.invoice.id + '/autopay-charge') %>" class="inline-form"><button class="button secondary" data-loading-text="Charging...">Charge Saved Autopay</button></form>
      <form method="POST" action="<%= routePath('/billing/invoices/' + invoice.invoice.id + '/payments') %>" class="inline-form payment-form"><span class="muted">Balance: <strong><%= formatCurrency(amountDue) %></strong></span><input type="number" step="0.01" name="amount" value="<%= amountDue.toFixed(2) %>" class="short-input"><select name="payment_method_id"><option value="">Method</option><% paymentMethods.forEach(method => { %><option value="<%= method.id %>"><%= method.name %></option><% }) %></select><button class="button secondary" type="submit">Record Manual Payment</button></form>
    <% } %>
    <% if(invoice.invoice.status_code === 'payment_pending'){ %><span class="badge">Payment Pending</span><% } %>
    <% if(invoice.invoice.status_code === 'payment_failed'){ %><span class="badge danger">Payment Failed</span><% } %>
    <% if(invoice.invoice.status_code === 'paid'){ %><span class="badge success">Paid</span><% } %>
    <% if(invoice.invoice.customer_id){ %><a class="button secondary" href="<%= routePath('/customers/' + invoice.invoice.customer_id) %>">View Customer</a><% } %>
    <% if(invoice.invoice.work_order_id){ %><a class="button secondary" href="<%= routePath('/work-orders/' + invoice.invoice.work_order_id) %>">View Work Order</a><% } %>
  </div>
</section>

<section class="card">
  <div class="grid two">
    <div><h2>Customer</h2><p><% if(invoice.invoice.customer_id){ %><a href="<%= routePath('/customers/' + invoice.invoice.customer_id) %>"><%= invoice.invoice.customer_name %></a><% } else { %><%= invoice.invoice.customer_name || '—' %><% } %></p></div>
    <div><h2>Status</h2><p><span class="badge"><%= invoice.invoice.status_name || 'Created' %></span></p></div>
  </div>
  <% if(invoice.invoice.work_order_id){ %><p class="muted">Generated from <a href="<%= routePath('/work-orders/' + invoice.invoice.work_order_id) %>"><%= invoice.invoice.work_order_title || ('Work Order #' + invoice.invoice.work_order_id) %></a></p><% } %>
  <% if(invoice.invoice.public_payment_token){ %>
    <div class="notice">
      <strong>Customer payment link:</strong>
      <a href="/pay/i/<%= invoice.invoice.public_payment_token %>" target="_blank">/pay/i/<%= invoice.invoice.public_payment_token %></a>
    </div>
  <% } else if(['submitted','payment_failed','payment_pending'].includes(invoice.invoice.status_code)){ %>
    <p class="muted">A public payment link will be generated when the invoice is submitted.</p>
  <% } %>
</section>

<section class="card">
  <div class="section-title-row">
    <h2>Totals</h2>
    <strong><%= formatCurrency(invoice.invoice.total_amount) %></strong>
  </div>

  <table class="data-table">
    <tbody>
      <tr><th>Subtotal</th><td><%= formatCurrency(invoice.invoice.subtotal || 0) %></td></tr>
      <% if(Number(invoice.invoice.discount_amount || 0) > 0){ %>
        <tr>
          <th>Discount</th>
          <td>
            -<%= formatCurrency(invoice.invoice.discount_amount || 0) %>
            <span class="muted">
              <% if(invoice.invoice.discount_type){ %> · <%= invoice.invoice.discount_type %><% } %>
              <% if(invoice.invoice.discount_value_type === 'percent'){ %> (<%= Number(invoice.invoice.discount_percent || 0) %>%)<% } %>
              <% if(invoice.invoice.discount_reason){ %> · <%= invoice.invoice.discount_reason %><% } %>
            </span>
          </td>
        </tr>
      <% } %>
      <tr><th>Taxable Amount</th><td><%= formatCurrency(invoice.invoice.taxable_amount || invoice.invoice.subtotal || 0) %></td></tr>
      <tr>
        <th>Tax</th>
        <td>
          <%= formatCurrency(invoice.invoice.tax_amount || 0) %>
          <span class="muted">
            (<%= ((Number(invoice.invoice.tax_rate || 0)) * 100).toFixed(3).replace(/0+$/,'').replace(/\.$/,'') %>%
            <% if(invoice.invoice.tax_county){ %> · <%= invoice.invoice.tax_county %><% } %><% if(invoice.invoice.tax_city){ %> / <%= invoice.invoice.tax_city %><% } %>)
          </span>
        </td>
      </tr>
      <tr><th>Invoice Total</th><td><strong><%= formatCurrency(invoice.invoice.total_amount || 0) %></strong></td></tr>
      <% if(Number(invoice.invoice.deposit_amount || 0) > 0){ %>
        <tr>
          <th>Deposit</th>
          <td>
            -<%= formatCurrency(invoice.invoice.deposit_amount || 0) %>
            <% if(invoice.invoice.deposit_note){ %><span class="muted"> · <%= invoice.invoice.deposit_note %></span><% } %>
          </td>
        </tr>
      <% } %>
      <tr><th>Balance Due</th><td><strong><%= formatCurrency(amountDue) %></strong></td></tr>
    </tbody>
  </table>
</section>

<section class="card">
  <div class="section-title-row"><h2>Line Items</h2><strong><%= formatCurrency(invoice.invoice.subtotal) %></strong></div>
  <table class="data-table"><thead><tr><th>Description</th><th>Qty</th><th>Unit Price</th><th>Amount</th></tr></thead><tbody>
    <% invoice.lineItems.forEach(item => { %><tr><td><%= item.description %></td><td><%= item.quantity %></td><td><%= formatCurrency(item.unit_price || 0) %></td><td><%= formatCurrency(item.line_total || 0) %></td></tr><% }) %>
    <% if(!invoice.lineItems.length){ %><tr><td colspan="4">No line items.</td></tr><% } %>
  </tbody></table>
</section>


<section class="card"><h2>Online Payment Attempts</h2>
  <% if(invoice.paymentAttempts && invoice.paymentAttempts.length){ %><table class="data-table"><thead><tr><th>Status</th><th>Type</th><th>Amount</th><th>Created</th><th>Failure</th></tr></thead><tbody><% invoice.paymentAttempts.forEach(attempt => { %><tr><td><span class="badge"><%= attempt.status %></span></td><td><%= attempt.payment_type === 'ach' ? 'ACH' : 'Card' %></td><td><%= formatCurrency(attempt.amount) %></td><td><%= formatDate(attempt.created_at) %></td><td><%= attempt.failure_message || '—' %></td></tr><% }) %></tbody></table><% } else { %><p class="muted">No online payment attempts yet.</p><% } %>
</section>

<section class="card"><h2>Payments</h2>
  <% if(invoice.payments.length){ %><table class="data-table"><thead><tr><th>Amount</th><th>Date</th><th>Method</th></tr></thead><tbody><% invoice.payments.forEach(payment => { %><tr><td><%= formatCurrency(payment.amount) %></td><td><%= payment.created_at ? new Date(payment.created_at).toLocaleString() : '—' %></td><td><%= payment.payment_method || '—' %></td></tr><% }) %></tbody></table><% } else { %><p class="muted">No payments recorded.</p><% } %>
</section>

<%- include('../partials-footer') %>
