<%- include('../partials-header', { title }) %>
<%
  const weekStart = new Date(board.start + 'T00:00:00Z');
  const weekEnd = new Date(board.end + 'T00:00:00Z');
  weekEnd.setUTCDate(weekEnd.getUTCDate() - 1);
  const weekLabel = `${weekStart.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })} – ${weekEnd.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}`;
  const prev = new Date(weekStart); prev.setUTCDate(prev.getUTCDate() - 7);
  const next = new Date(weekStart); next.setUTCDate(next.getUTCDate() + 7);
  const prevWeek = prev.toISOString().slice(0,10);
  const nextWeek = next.toISOString().slice(0,10);
  const days = [];
  for (let i = 0; i < 7; i++) { const d = new Date(weekStart); d.setUTCDate(weekStart.getUTCDate() + i); days.push(d); }
  const columns = [{ id: 'unassigned', display_name: 'Unassigned' }].concat(board.technicians || []);
  const jobsByCell = {};
  (board.workOrders || []).forEach(w => {
    const dayKey = new Date(w.scheduled_date).toISOString().slice(0,10);
    const userKey = w.assigned_user_id ? String(w.assigned_user_id) : 'unassigned';
    (jobsByCell[`${dayKey}|${userKey}`] ||= []).push(w);
  });
  const closuresByDate = {};
  (board.closures || []).forEach(c => { const k = new Date(c.closure_date).toISOString().slice(0,10); (closuresByDate[k] ||= []).push(c); });
  const capacityByUserService = {};
  const defaultCapacityByUser = {};
  (board.capacities || []).forEach(c => {
    if (c.service_line_id) capacityByUserService[`${c.user_id}|${c.service_line_id}`] = Number(c.max_jobs_per_day || 0);
    else defaultCapacityByUser[String(c.user_id)] = Number(c.max_jobs_per_day || 0);
  });
  function cellJobs(dayKey, columnId) { return jobsByCell[`${dayKey}|${columnId}`] || []; }
  function capacityFor(columnId, jobs) {
    if (columnId === 'unassigned') return null;
    if (!jobs.length) return defaultCapacityByUser[String(columnId)] || null;
    const serviceLineId = jobs[0].service_line_id;
    return capacityByUserService[`${columnId}|${serviceLineId}`] || defaultCapacityByUser[String(columnId)] || null;
  }
%>
<section class="page-header">
  <div>
    <h1>Dispatch Board</h1>
  </div>
  <div class="button-row">
    <a class="button secondary" href="<%= routePath('/scheduling/calendar') %>">Month Calendar</a>
    <a class="button secondary" href="<%= routePath('/scheduling/closures') %>">Blackout Dates</a>
    <a class="button secondary" href="<%= routePath('/scheduling/capacity') %>">Technician Capacity</a>
  </div>
</section>

<section class="card schedule-toolbar">
  <a class="button secondary" href="<%= routePath('/scheduling/dispatch?week=' + prevWeek) %>">← Previous Week</a>
  <h2><%= weekLabel %></h2>
  <a class="button secondary" href="<%= routePath('/scheduling/dispatch?week=' + nextWeek) %>">Next Week →</a>
</section>


<section class="dispatch-board" data-update-url-template="<%= routePath('/scheduling/work-orders/__ID__/schedule') %>">
  <div class="dispatch-grid" style="--dispatch-cols:<%= columns.length %>">
    <div class="dispatch-corner">Week</div>
    <% columns.forEach(col => { %>
      <div class="dispatch-tech-head"><%= col.display_name %></div>
    <% }) %>

    <% days.forEach(day => { const dayKey = day.toISOString().slice(0,10); const closures = closuresByDate[dayKey] || []; const isWeekend = day.getUTCDay() === 0 || day.getUTCDay() === 6; %>
      <div class="dispatch-day-head <%= isWeekend ? 'weekend' : '' %> <%= closures.length ? 'closed-day' : '' %>">
        <strong><%= day.toLocaleDateString('en-US', { weekday: 'short', timeZone: 'UTC' }) %></strong>
        <span><%= day.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }) %></span>
        <% closures.forEach(c => { %><small>Closed: <%= c.reason %><%= c.service_line ? ' · ' + c.service_line : '' %></small><% }) %>
      </div>
      <% columns.forEach(col => { const jobs = cellJobs(dayKey, String(col.id)); const cap = capacityFor(String(col.id), jobs); const over = cap && jobs.length > cap; %>
        <div class="dispatch-cell <%= over ? 'over-capacity' : '' %>" data-date="<%= dayKey %>" data-user-id="<%= col.id %>">
          <div class="dispatch-cell-meta">
            <span><%= jobs.length %> job<%= jobs.length === 1 ? '' : 's' %></span>
            <% if (cap) { %><span class="capacity-pill <%= over ? 'danger' : '' %>"><%= jobs.length %>/<%= cap %></span><% } %>
          </div>
          <% jobs.forEach(w => { %>
            <a draggable="true" class="dispatch-job service-<%= w.service_line_code %> status-<%= w.status_code %>" data-work-order-id="<%= w.id %>" href="<%= routePath('/work-orders/' + w.id) %>">
              <strong><%= w.title %></strong>
              <span><%= w.customer %></span>
              <small><%= w.service_line %> · <%= w.status %></small>
            </a>
          <% }) %>
        </div>
      <% }) %>
    <% }) %>
  </div>
</section>

<script>
(function(){
  const board = document.querySelector('.dispatch-board');
  if (!board) return;
  const template = board.dataset.updateUrlTemplate;
  let dragged = null;

  document.querySelectorAll('.dispatch-job').forEach(card => {
    card.addEventListener('dragstart', event => {
      dragged = card;
      card.classList.add('dragging');
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData('text/plain', card.dataset.workOrderId);
    });
    card.addEventListener('dragend', () => {
      card.classList.remove('dragging');
      dragged = null;
      document.querySelectorAll('.dispatch-cell.drag-over').forEach(cell => cell.classList.remove('drag-over'));
    });
    card.addEventListener('click', event => {
      if (card.classList.contains('dragging')) event.preventDefault();
    });
  });

  document.querySelectorAll('.dispatch-cell').forEach(cell => {
    cell.addEventListener('dragover', event => {
      event.preventDefault();
      cell.classList.add('drag-over');
      event.dataTransfer.dropEffect = 'move';
    });
    cell.addEventListener('dragleave', () => cell.classList.remove('drag-over'));
    cell.addEventListener('drop', async event => {
      event.preventDefault();
      cell.classList.remove('drag-over');
      const workOrderId = event.dataTransfer.getData('text/plain');
      if (!workOrderId || !dragged) return;
      const url = template.replace('__ID__', encodeURIComponent(workOrderId));
      const body = {
        scheduled_date: cell.dataset.date,
        assigned_user_id: cell.dataset.userId === 'unassigned' ? '' : cell.dataset.userId
      };
      try {
        cell.classList.add('updating');
        const response = await fetch(url, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(body)
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.ok) throw new Error(payload.error || 'Could not update schedule.');
        window.location.reload();
      } catch (error) {
        alert(error.message || 'Could not update schedule.');
      } finally {
        cell.classList.remove('updating');
      }
    });
  });
})();
</script>
<%- include('../partials-footer') %>
