---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";

const BRAND = {
  name: "Alliance Home Services",
  garageDivision: "Alliance Garage Doors of Roswell",
  poolDivision: "Spring Water Pool Services",
  garagePhone: "(770)742-9433",
  garagePhoneHref: "7707429433",
  poolPhone: "(470)524-2197",
  poolPhoneHref: "4705242197",
  email: "contact@agdofroswell.com",
  address: "Roswell, GA 30075",
};

const title = `${BRAND.name} | Reliable Garage Door and Pool Services for Metro Atlanta Homes`;
const description =
  "Alliance Home Services offers garage door services and pool services for Roswell and Metro Atlanta homes.";
---

<Base {title} {description}>
  <SiteHeader variant="home" />

  <main>
    <section class="relative overflow-hidden bg-[#06264a] text-white">
      <div class="absolute inset-0">
        <img src="/After1.webp" alt="Finished garage door project" class="h-full w-full object-cover opacity-45" />
        <div class="absolute inset-0 bg-[linear-gradient(135deg,_rgba(6,31,62,0.97)_0%,_rgba(6,38,74,0.92)_48%,_rgba(8,104,144,0.72)_100%)]"></div>
      </div>
      <div class="relative mx-auto max-w-7xl px-4 py-20 md:py-28 lg:py-32">
        <div class="max-w-4xl">
          <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-[#b8ca80]">{BRAND.name}</p>
          <h1 class="text-4xl font-bold leading-tight tracking-tight md:text-6xl">
            Reliable Garage Door and Pool Services for Metro Atlanta Homes
          </h1>
        </div>
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          <article id="garage-division" class="rounded-3xl border border-white/15 bg-[#f7f5ef] p-8 text-slate-900 shadow-xl shadow-black/20 backdrop-blur">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-[#7d9253]">Garage Door Services</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-[#08284c]">{BRAND.garageDivision}</h2>
            <p class="mt-4 text-slate-600">
              Repairs, springs, openers, new doors, and maintenance remain a major service division under Alliance Home Services.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="/garage-doors" class="rounded-lg bg-[#06264a] px-6 py-4 font-semibold text-white shadow-sm hover:bg-[#0a335f]">Explore Garage Services</a>
              <a href={`tel:${BRAND.garagePhoneHref}`} class="rounded-lg border border-[#06264a]/15 bg-white px-6 py-4 font-semibold text-[#06264a] hover:border-[#7d9253] hover:text-[#5f743d]">Call {BRAND.garagePhone}</a>
            </div>
          </article>

          <article id="pool-division" class="rounded-3xl border border-cyan-200/60 bg-[linear-gradient(135deg,_#06264a_0%,_#0a6b92_55%,_#79d8f7_100%)] p-8 text-white shadow-xl shadow-black/20">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-[#d8f6ff]">Pool Services</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight">{BRAND.poolDivision}</h2>
            <p class="mt-4 text-white/88">
              Keep leaves, pollen, cloudy water, and missed maintenance from taking over. Request cleaning, water testing and balancing, recurring care, or a basic equipment check.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="/pool-services" class="rounded-lg bg-white px-6 py-4 font-semibold text-[#075c7e] shadow-sm hover:bg-[#e8fbff]">Explore Pool Services</a>
              <a href={`tel:${BRAND.poolPhoneHref}`} class="rounded-lg border border-white/40 bg-white/10 px-6 py-4 font-semibold text-white backdrop-blur hover:bg-white/20">Call {BRAND.poolPhone}</a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-[#06264a] text-white">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 text-sm md:grid-cols-4">
      <div>
        <img src="/logo-main.webp" alt={`${BRAND.name} logo`} class="h-16 w-auto rounded bg-white p-2" />
        <p class="mt-4 text-white/70">Garage door expertise and practical pool care for Roswell and Metro Atlanta homes.</p>
      </div>
      <div>
        <p class="font-semibold">Quick Links</p>
        <ul class="mt-3 space-y-2 text-white/75">
          <li><a class="hover:text-[#9aad68]" href="/">Home</a></li>
          <li><a class="hover:text-[#9aad68]" href="/garage-doors">Garage Doors</a></li>
          <li><a class="hover:text-[#78d9ff]" href="/pool-services">Pool Services</a></li>
          <li><a class="hover:text-[#9aad68]" href="/specials">Specials</a></li>
          <li><a class="hover:text-[#9aad68]" href="/garage-doors#contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="font-semibold">Contact</p>
        <ul class="mt-3 space-y-2 text-white/75">
          <li>Garage Doors: <a class="hover:text-[#9aad68]" href={`tel:${BRAND.garagePhoneHref}`}>{BRAND.garagePhone}</a></li>
          <li>Pool: <a class="hover:text-[#78d9ff]" href={`tel:${BRAND.poolPhoneHref}`}>{BRAND.poolPhone}</a></li>
          <li><a class="hover:text-[#9aad68]" href={`mailto:${BRAND.email}`}>{BRAND.email}</a></li>
          <li>{BRAND.address}</li>
        </ul>
      </div>
      <div>
        <p class="font-semibold">Divisions</p>
        <ul class="mt-3 space-y-2 text-white/75">
          <li>{BRAND.garageDivision}</li>
          <li>{BRAND.poolDivision}</li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10 py-4 text-center text-xs text-white/55">© {new Date().getFullYear()} {BRAND.name}. All rights reserved.</div>
  </footer>

  <script type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HomeAndConstructionBusiness",
      name: BRAND.name,
      telephone: BRAND.garagePhone,
      email: BRAND.email,
      address: {
        "@type": "PostalAddress",
        streetAddress: BRAND.address,
        addressLocality: "Roswell",
        addressRegion: "GA",
        postalCode: "30075",
        addressCountry: "US"
      },
      url: "https://agdofroswell.com"
    })}
  </script>

</Base>
