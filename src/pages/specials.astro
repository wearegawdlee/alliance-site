---
import Base from "../layouts/Base.astro";

const BIZ = {
  name: "Alliance Garage Doors of Roswell",
  phone: "(770)742-9433",
  phoneHref: "7707429433",
  email: "contact@agdofroswell.com",
  hours: "Mon–Sun 9:00am–8:00pm",
  site: "agdofroswell.com",
};

const title = `Spring Replacement & Conversion Special | ${BIZ.name}`;
const description =
  "Spring Replacement & Conversion Special: $150 off service through June 30, 2026. Free inspections and free quotes from Alliance Garage Doors of Roswell.";
---

<Base {title} {description}>
  <section class="relative overflow-hidden bg-[#f5f6fb] text-[#0f2f67]">
    <div class="pointer-events-none absolute -left-12 top-[-2rem] h-28 w-28 rounded-full border-2 border-dotted border-[#0f2f67]/40"></div>
    <div class="pointer-events-none absolute -right-10 top-24 h-24 w-24 rounded-full border-2 border-dotted border-[#0f2f67]/35"></div>
    <div class="pointer-events-none absolute -left-8 bottom-24 h-24 w-24 rounded-full border-2 border-dotted border-[#0f2f67]/35"></div>

    <div class="mx-auto max-w-6xl px-4 py-8 md:py-10">
      <div class="grid items-center gap-10 lg:grid-cols-[0.95fr_1.05fr]">
        <div>
          <div class="flex justify-start">
            <a href="/" aria-label="Visit full website">
              <img src="/logo-main.webp" alt={`${BIZ.name} logo`} class="h-16 object-contain md:h-20" />
            </a>
          </div>

          <div class="mt-6 max-w-xl">
            <h1 class="text-4xl font-semibold leading-[0.95] tracking-tight md:text-6xl">
              SPRING INTO SMOOTH OPERATION
            </h1>

            <div class="mt-8 space-y-4 text-[#1a2142]">
              <p class="text-2xl leading-snug md:text-[2rem]">
                Spring Replacement &amp;<br />
                Conversion Special<br />
                <span class="font-semibold text-[#0f2f67]">$150 OFF</span>
              </p>

              <div class="pt-2 text-lg uppercase tracking-wide text-[#4a5678]">
                <p>Free Inspections</p>
                <p>Free Quotes</p>
              </div>
            </div>

            <div class="mt-8 grid gap-3 sm:max-w-sm">
              <a href="#quick-estimate" class="rounded-2xl bg-[#0f2f67] px-6 py-4 text-center text-base font-medium text-white shadow-lg hover:bg-[#0c2755]">
                Claim My $150 Off
              </a>
              <a href={`tel:${BIZ.phoneHref}`} class="rounded-2xl border border-[#0f2f67]/15 bg-white px-6 py-4 text-center text-base font-medium text-[#0f2f67] hover:bg-[#eef2ff]">
                Call {BIZ.phone}
              </a>
            </div>
          </div>
        </div>

        <div class="relative flex justify-center lg:justify-end">
          <div class="relative h-[22rem] w-[22rem] md:h-[32rem] md:w-[32rem]">
            <div class="absolute inset-0 rounded-full bg-[repeating-linear-gradient(45deg,#27335f_0_14px,transparent_14px_28px)]"></div>
            <div class="absolute inset-[1.15rem] overflow-hidden rounded-full bg-white shadow-2xl md:inset-[1.5rem]">
              <img src="/After1.webp" alt="Garage door opening smoothly" class="h-full w-full object-cover" />
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 grid gap-4 border-t border-[#0f2f67]/10 pt-6 text-[#1a2142] md:grid-cols-2 md:items-center">
        <div class="flex items-center gap-3 text-base">
          <span class="text-xl">🌐</span>
          <span>{BIZ.site}</span>
        </div>
        <div class="text-sm uppercase tracking-wide text-[#4a5678] md:text-right">{BIZ.hours}</div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-10 md:py-12">
      <form
        id="quick-estimate"
        class="rounded-[2rem] border border-[#0f2f67]/10 bg-[#f9faff] p-5 text-neutral-900 shadow-sm md:p-7"
        action="https://formspree.io/f/xdkwwdnv"
        method="POST"
      >
        <input type="hidden" name="form_name" value="bio-funnel-specials" />
        <input type="hidden" name="landing_page" value="/specials" />

        <div class="mb-5 text-center">
          <h2 class="text-2xl font-semibold text-[#0f2f67]">Claim your spring special</h2>
          <p class="mt-2 text-sm text-neutral-600">Tell us what you need and we’ll follow up fast.</p>
        </div>

        <div class="grid gap-3 md:grid-cols-2">
          <div>
            <label class="block text-sm font-medium" for="name">Name</label>
            <input id="name" name="name" required autocomplete="name" class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-3 py-2" />
          </div>
          <div>
            <label class="block text-sm font-medium" for="phone">Phone</label>
            <input id="phone" name="phone" required autocomplete="tel" class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-3 py-2" />
          </div>
        </div>

        <div class="mt-3">
          <label class="block text-sm font-medium" for="address">Address</label>
          <input id="address" name="address" required autocomplete="address-line1" class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-3 py-2" />
        </div>

        <div class="mt-3 grid gap-3 md:grid-cols-3">
          <div>
            <label class="block text-sm font-medium" for="city">City</label>
            <input id="city" name="city" required autocomplete="address-level2" class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-3 py-2" />
          </div>
          <div>
            <label class="block text-sm font-medium" for="state">State</label>
            <input id="state" name="state" value="GA" readonly autocomplete="address-level1" class="mt-1 w-full rounded-xl border border-neutral-300 bg-neutral-50 px-3 py-2 text-neutral-600" />
          </div>
          <div>
            <label class="block text-sm font-medium" for="zip">ZIP Code</label>
            <input id="zip" name="zip" required inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-3 py-2" />
          </div>
        </div>

        <div class="mt-3">
          <label class="block text-sm font-medium" for="service_type">Service Type</label>
          <select id="service_type" name="service_type" required class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-3 py-2">
            <option value="">Select one</option>
            <option>Spring Replacement</option>
            <option>Spring Conversion</option>
            <option>Spring Repair / Inspection</option>
            <option>Not Sure Yet</option>
          </select>
        </div>

        <div class="mt-3">
          <label class="block text-sm font-medium" for="message">What do you need?</label>
          <textarea id="message" name="message" rows={3} class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-3 py-2" placeholder="Broken spring, aging springs, conversion question, inspection request, etc."></textarea>
        </div>

        <button type="submit" class="mt-5 w-full rounded-2xl bg-[#0f2f67] px-5 py-3 font-medium text-white hover:bg-[#0c2755]">
          Claim My $150 Off
        </button>

        <p class="mt-3 text-center text-xs text-neutral-500">By submitting, you agree to be contacted about your service request.</p>
      </form>
    </div>
  </section>

  <script src="/form.js" defer></script>
</Base>
