---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";

const BRAND = {
  name: "Alliance Home Services",
  garageDivision: "Alliance Garage Doors of Roswell",
  poolDivision: "Spring Water Pool Services",
  garagePhone: "(770)742-9433",
  garagePhoneHref: "7707429433",
  poolPhone: "(470)524-2197",
  poolPhoneHref: "4705242197",
};

const title = `Specials | ${BRAND.name}`;
const description =
  "Choose the right Alliance Home Services special for garage door service or pool service.";
---

<Base {title} {description}>
  <SiteHeader variant="specials" />

  <main>
    <section class="relative overflow-hidden bg-[#06264a] text-white">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(184,202,128,0.18),_transparent_30%),linear-gradient(135deg,_#041a33_0%,_#06264a_46%,_#0b4c70_100%)]"></div>
      <div class="relative mx-auto max-w-7xl px-4 py-18 md:py-24">
        <div class="max-w-4xl">
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#b8ca80]">{BRAND.name}</p>
          <h1 class="mt-5 text-4xl font-bold leading-tight tracking-tight md:text-6xl">Choose the special that matches the service you need.</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-white/90">
            Pick your lane first so the offer, form, and follow-up all stay aligned with the job you actually want.
          </p>
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          <a href="/garage-door-specials" class="group rounded-[2rem] border border-white/15 bg-white/10 p-8 shadow-2xl shadow-black/20 backdrop-blur transition hover:-translate-y-1 hover:bg-white/14">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-[#b8ca80]">{BRAND.garageDivision}</p>
            <h2 class="mt-4 text-3xl font-bold tracking-tight">Garage Door Special</h2>
            <p class="mt-4 max-w-xl text-base leading-7 text-white/82">
              Spring replacement and conversion offer for garage door customers who want the dedicated garage service lane.
            </p>
            <div class="mt-8 inline-flex items-center gap-3 rounded-full bg-[#7d9253] px-5 py-3 font-semibold text-white transition group-hover:bg-[#6d814a]">
              View Garage Door Special
            </div>
          </a>

          <a href="/pool-specials" class="group rounded-[2rem] border border-white/15 bg-white/10 p-8 shadow-2xl shadow-black/20 backdrop-blur transition hover:-translate-y-1 hover:bg-white/14">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-[#8fe8ff]">{BRAND.poolDivision}</p>
            <h2 class="mt-4 text-3xl font-bold tracking-tight">Pool Services Special</h2>
            <p class="mt-4 max-w-xl text-base leading-7 text-white/82">
              Pool-only specials for recurring service, seasonal help, and clean route-specific follow-up.
            </p>
            <div class="mt-8 inline-flex items-center gap-3 rounded-full bg-white px-5 py-3 font-semibold text-[#075c7e] transition group-hover:bg-[#e8fbff]">
              View Pool Services Special
            </div>
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>
