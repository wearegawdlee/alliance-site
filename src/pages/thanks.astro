---
import Base from "../layouts/Base.astro";

const title = "Thanks | Alliance Home Services";
const description = "Thanks for contacting Alliance Home Services. We will follow up soon.";
---

<Base {title} {description}>
  <section class="min-h-screen bg-[#f5f6fb] text-[#0f2f67]">
    <div class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-4 py-12 text-center">
      <a href="/" aria-label="Visit home page">
        <img src="/logo-main.webp" alt="Alliance Home Services logo" class="mx-auto h-20 object-contain md:h-24" />
      </a>

      <div class="mt-8 rounded-[2rem] border border-[#0f2f67]/10 bg-white px-6 py-10 shadow-sm md:px-10">
        <h1 class="text-3xl font-semibold md:text-4xl">Thanks — we got your request</h1>
        <p class="mt-4 text-base text-[#1a2142] md:text-lg">
          Someone from Alliance Home Services will follow up with you soon.
        </p>
        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <a href="tel:7707429433" class="rounded-2xl bg-[#0f2f67] px-6 py-3 font-medium text-white hover:bg-[#0c2755]">
            Call Now
          </a>
          <a href="/" class="rounded-2xl border border-[#0f2f67]/15 bg-white px-6 py-3 font-medium text-[#0f2f67] hover:bg-[#eef2ff]">
            Back to Home
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
